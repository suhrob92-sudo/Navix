# ---------------------------------------------------------------------------
# Navix — muhit o'zgaruvchilari namunasi
#
# Ishlatish: ushbu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
#   cp .env.example .env
#
# DIQQAT: ".env" faylini hech qachon Git'ga qo'shmang — u maxfiy kalitlarni saqlaydi.
# ---------------------------------------------------------------------------

# Ilova rejimi: development | test | production
NODE_ENV=development

# --- Ma'lumotlar bazasi (PostgreSQL) --------------------------------------
# docker-compose bilan ishlaganda quyidagi qiymat to'g'ri keladi.
DATABASE_URL="postgresql://navix:navix@localhost:5432/navix?schema=public"

# --- Redis (kesh, sessiya, rate limit) ------------------------------------
REDIS_URL="redis://localhost:6379"

# --- JWT kalitlari ---------------------------------------------------------
# Har biri kamida 32 belgidan iborat bo'lishi SHART.
# Yangi kalit yaratish: openssl rand -base64 48
JWT_ACCESS_SECRET="bu-qiymatni-almashtiring-kamida-32-belgi-bolsin"
JWT_REFRESH_SECRET="bu-qiymatni-ham-almashtiring-kamida-32-belgi"

# Token amal qilish muddati (soniyalarda)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- SMS xizmati -----------------------------------------------------------
# console — kod terminalga chiqadi (ishlab chiqish uchun, SMS yuborilmaydi)
# eskiz   — Eskiz.uz orqali haqiqiy SMS yuboriladi
SMS_PROVIDER=console

# Quyidagilar faqat SMS_PROVIDER=eskiz bo'lganda kerak.
# Hisob ochish: https://eskiz.uz
# ESKIZ_EMAIL="siz@example.com"
# ESKIZ_SECRET="eskiz-api-paroli"
# ESKIZ_SENDER="4546"

# --- Tasdiqlash kodi (OTP) -------------------------------------------------
# Kod necha soniya amal qiladi (300 = 5 daqiqa)
OTP_TTL=300
# Kodni qayta yuborishdan oldin kutish vaqti (soniya)
OTP_RESEND_COOLDOWN=60
# Bitta kodni necha marta noto'g'ri kiritish mumkin
OTP_MAX_ATTEMPTS=5

# --- Log ------------------------------------------------------------------
# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Ilova (brauzerga ham ko'rinadi) --------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Navix"

# ---------------------------------------------------------------------------
# Navix — muhit o'zgaruvchilari namunasi
#
# Ishlatish: ushbu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
#   cp .env.example .env
#
# DIQQAT: ".env" faylini hech qachon Git'ga qo'shmang — u maxfiy kalitlarni saqlaydi.
# ---------------------------------------------------------------------------

# Ilova rejimi: development | test | production
NODE_ENV=development

# --- Ma'lumotlar bazasi (PostgreSQL) --------------------------------------
# docker-compose bilan ishlaganda quyidagi qiymat to'g'ri keladi.
DATABASE_URL="postgresql://navix:navix@localhost:5432/navix?schema=public"

# --- Redis (kesh, sessiya, rate limit) ------------------------------------
REDIS_URL="redis://localhost:6379"

# --- JWT kalitlari ---------------------------------------------------------
# Har biri kamida 32 belgidan iborat bo'lishi SHART.
# Yangi kalit yaratish: openssl rand -base64 48
JWT_ACCESS_SECRET="bu-qiymatni-almashtiring-kamida-32-belgi-bolsin"
JWT_REFRESH_SECRET="bu-qiymatni-ham-almashtiring-kamida-32-belgi"

# Token amal qilish muddati (soniyalarda)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- SMS xizmati -----------------------------------------------------------
# console — kod terminalga chiqadi (ishlab chiqish uchun, SMS yuborilmaydi)
# eskiz   — Eskiz.uz orqali haqiqiy SMS yuboriladi
SMS_PROVIDER=console

# Quyidagilar faqat SMS_PROVIDER=eskiz bo'lganda kerak.
# Hisob ochish: https://eskiz.uz
# ESKIZ_EMAIL="siz@example.com"
# ESKIZ_SECRET="eskiz-api-paroli"
# ESKIZ_SENDER="4546"

# --- Tasdiqlash kodi (OTP) -------------------------------------------------
# Kod necha soniya amal qiladi (300 = 5 daqiqa)
OTP_TTL=300
# Kodni qayta yuborishdan oldin kutish vaqti (soniya)
OTP_RESEND_COOLDOWN=60
# Bitta kodni necha marta noto'g'ri kiritish mumkin
OTP_MAX_ATTEMPTS=5

# --- Log ------------------------------------------------------------------
# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Ilova (brauzerga ham ko'rinadi) --------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Navix"

# --- Rasmlar (fayl saqlash) -----------------------------------------------
# IXTIYORIY. Berilmasa rasmlar mahalliy ".uploads/" papkasiga yoziladi —
# bu faqat ishlab chiqish uchun yetarli.
#
# Vercel'da MAJBURIY: u yerda disk vaqtinchalik va yozilgan fayl
# bir necha daqiqadan keyin yo'qoladi.
# Olish: Vercel -> loyiha -> Storage -> Create -> Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ===========================================================================
# PRODUCTION (Vercel) uchun
# ===========================================================================
#
# Yuqoridagi qiymatlar LOKAL ishlash uchun. Vercel'ga chiqarishda ular
# boshqacha bo'ladi va Vercel sahifasidagi "Environment Variables"
# bo'limiga yoziladi — bu faylga EMAS.
#
# Tekshirish uchun ".env.production" faylini yarating va shu qiymatlarni
# unga yozing, keyin:  npm run deploy:check
# (".env.production" ham Git'ga tushmaydi.)
#
# --- Baza: Neon.tech (bepul) ----------------------------------------------
# Ikkita manzil beriladi, IKKALASI ham kerak:
#   DATABASE_URL — "Pooled connection" (ilova uchun)
#   DIRECT_URL   — "Direct connection" (faqat migratsiya uchun)
# DATABASE_URL="postgresql://user:parol@ep-xxx-pooler.eu-central-1.aws.neon.tech/navix?sslmode=require"
# DIRECT_URL="postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/navix?sslmode=require"
#
# --- Redis: Upstash.com (bepul) -------------------------------------------
# "rediss://" bilan boshlanadi — bu shifrlangan ulanish degani.
# REDIS_URL="rediss://default:parol@eu1-xxx.upstash.io:6379"
#
# --- Ilova manzili ---------------------------------------------------------
# Vercel bergan manzil. Deploy'dan keyin ma'lum bo'ladi.
# NEXT_PUBLIC_APP_URL="https://navix.vercel.app"

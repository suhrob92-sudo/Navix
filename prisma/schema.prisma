// Navix — Markaziy Osiyo uchun AI Super App
// Prisma sxemasi: 1-bosqich (yadro — identifikatsiya, ruxsatlar, hamyon, audit).
//
// Prinsiplar:
//  - Normalizatsiya: har bir ma'lumot faqat bitta joyda saqlanadi;
//  - Har bir modul o'z prefiksiga ega jadvallardan foydalanadi (microservice'ga
//    ajratish oson bo'lishi uchun);
//  - Pul qiymatlari HECH QACHON float bo'lmaydi — faqat butun "tiyin" (BigInt);
//  - Barcha o'chirishlar "soft delete" (deletedAt) orqali — moliyaviy tarix yo'qolmaydi.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUM'lar
// ---------------------------------------------------------------------------

enum UserStatus {
  /// Ro'yxatdan o'tgan, lekin telefon/email tasdiqlanmagan.
  PENDING_VERIFICATION
  /// To'liq faol foydalanuvchi.
  ACTIVE
  /// Vaqtincha bloklangan (qoidabuzarlik, xavfsizlik).
  SUSPENDED
  /// Foydalanuvchi o'zi hisobni yopgan.
  DEACTIVATED
}

enum RoleName {
  CUSTOMER
  DRIVER
  COURIER
  MERCHANT
  EMPLOYER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum Language {
  UZ
  RU
  EN
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  /// Hamyonga pul kiritish.
  TOP_UP
  /// Hamyondan yechish.
  WITHDRAWAL
  /// Xizmat uchun to'lov.
  PAYMENT
  /// To'lovni qaytarish.
  REFUND
  /// Foydalanuvchidan foydalanuvchiga o'tkazma.
  TRANSFER
  /// Bonus / cashback.
  BONUS
  /// Ishlab topilgan pul — kuryer yetkazish haqi, haydovchi safari.
  ///
  /// `TOP_UP` dan farqi manbada: to'ldirishni foydalanuvchi o'zi
  /// qiladi, daromadni esa platforma yozadi. Tarixda ular alohida
  /// ko'rinishi kerak — kuryer "bugun qancha ishladim?" degan savolga
  /// javob topa olsin.
  EARNING
}

/// Pulning yo'nalishi. Turdan TAXMIN QILIB bo'lmaydi: o'tkazmada
/// yuboruvchi uchun chiqim, qabul qiluvchi uchun kirim — turi esa
/// ikkalasida ham TRANSFER. Shuning uchun aniq saqlanadi.
enum TransactionDirection {
  /// Hamyonga kirdi.
  IN
  /// Hamyondan chiqdi.
  OUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

/// Xizmat turlari — to'lovlar moduli uchun.
enum ServiceCategory {
  /// Kommunal: gaz, suv, elektr, issiqlik.
  UTILITY
  /// Internet provayderlari.
  INTERNET
  /// Uyali aloqa hisobini to'ldirish.
  MOBILE
  /// Kabel va raqamli televidenie.
  TV
}

/// Xizmat to'lovining holati.
enum ServicePaymentStatus {
  /// Provayderga yuborilgan, javob kutilmoqda.
  PENDING
  /// Muvaffaqiyatli yakunlangan.
  COMPLETED
  /// Provayder rad etdi yoki xatolik bo'ldi.
  FAILED
  /// Pul foydalanuvchiga qaytarildi.
  REFUNDED
}

/// Ovqat buyurtmasining holati.
///
/// Tartib ATAYLAB shunday: buyurtma faqat oldinga harakatlanadi.
/// Orqaga qaytish yo'q — bekor qilish alohida yakuniy holat.
enum FoodOrderStatus {
  /// Yaratildi, restoran hali javob bermagan.
  PENDING
  /// Restoran qabul qildi.
  CONFIRMED
  /// Oshxonada tayyorlanmoqda.
  PREPARING
  /// Kuryer yo'lda.
  DELIVERING
  /// Yetkazib berildi.
  DELIVERED
  /// Bekor qilindi (pul qaytarilgan).
  CANCELLED
}

/// Marketplace buyurtmasining holati.
///
/// Ovqatdan FARQ QILADI va bu ataylab: ovqat 45 daqiqada yetkaziladi,
/// mahsulot esa kunlab yo'lda bo'ladi. Shuning uchun bosqichlar ham
/// boshqacha — "tayyorlanmoqda" o'rniga "yig'ilmoqda" va "jo'natildi".
enum MarketOrderStatus {
  /// Yaratildi, sotuvchi hali javob bermagan.
  PENDING
  /// Sotuvchi qabul qildi.
  CONFIRMED
  /// Omborda yig'ilmoqda va qadoqlanmoqda.
  PACKING
  /// Yo'lga chiqarildi.
  SHIPPED
  /// Yetkazib berildi.
  DELIVERED
  /// Bekor qilindi (pul qaytarilgan, zaxira tiklangan).
  CANCELLED
}

/// Mehmonxona bandlovining holati.
///
/// ── Nima uchun "kutilmoqda" YO'Q ──────────────────────────────────────
/// Ovqat va Marketplace'da sotuvchi buyurtmani qabul qilishi kerak edi.
/// Bu yerda esa xona bo'shligi BANDLOV PAYTIDA tekshiriladi va darhol
/// biriktiriladi — kutadigan hech kim yo'q.
///
/// Bu enum IKKI modulda ishlatiladi: mehmonxona bandlovi va sayohat
/// chiptasi. Ikkalasining hayot yo'li bir xil — band qilindi, o'tib
/// ketdi yoki bekor qilindi. Ikki nusxa enum yuritish ularni
/// bir-biridan ajratib yuborardi.
enum BookingStatus {
  /// Band qilindi, pul yechildi.
  CONFIRMED
  /// O'tib bo'lgan: mehmon yashab chiqdi yoki reys jo'nab ketdi.
  COMPLETED
  /// Bekor qilindi, pul (to'liq yoki qisman) qaytarildi.
  CANCELLED
}

/// Sayohat turi — reys qanday vosita bilan bajariladi.
enum TransportType {
  PLANE
  TRAIN
  BUS
}

/// Jins — ixtiyoriy maydon.
enum Gender {
  MALE
  FEMALE
}

/// Kimdan xabar qabul qilinadi.
enum MessagePrivacy {
  /// Hamma yoza oladi.
  EVERYONE
  /// Faqat men kuzatadigan odamlar.
  FOLLOWERS
  /// Hech kim — xabarlar butunlay yopiq.
  NOBODY
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  READ
  FAILED
}

// ---------------------------------------------------------------------------
// Identifikatsiya (Identity)
// ---------------------------------------------------------------------------

/// Platformaning markaziy foydalanuvchi jadvali.
/// Barcha modullar (taksi, savdo, ish) shu bitta hisobdan foydalanadi.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// E.164 formatidagi telefon raqami (+998901234567) — asosiy identifikator.
  phone         String     @unique @db.VarChar(20)
  phoneVerified DateTime?
  email         String?    @unique @db.VarChar(255)
  emailVerified DateTime?
  /// Argon2/bcrypt hash. Ochiq parol hech qachon saqlanmaydi.
  passwordHash  String?    @db.VarChar(255)
  status        UserStatus @default(PENDING_VERIFICATION)

  firstName String? @db.VarChar(100)
  lastName  String? @db.VarChar(100)
  avatarUrl String? @db.VarChar(500)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profile           UserProfile?
  feedSettings      FeedSettings?
  roles             UserRoleAssignment[]
  sessions          Session[]
  wallet            Wallet?
  addresses         Address[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  savedAccounts     SavedAccount[]
  payments          ServicePayment[]
  foodOrders        FoodOrder[]
  restaurants       Restaurant[]
  shops             Shop[]               @relation("ShopOwner")
  marketOrders      MarketOrder[]
  deliveries        Delivery[]           @relation("CourierDeliveries")
  companies         Company[]            @relation("CompanyOwner")
  applications      JobApplication[]
  parcels           Parcel[]
  bookings          HotelBooking[]
  tickets           TripBooking[]
  following         Follow[]             @relation("Following")
  followers         Follow[]             @relation("Followers")
  businessFollows   BusinessFollow[]
  chatMemberships   ConversationMember[]
  sentMessages      Message[]
  messageReactions  MessageReaction[]
  outgoingCalls     Call[]               @relation("CallCaller")
  incomingCalls     Call[]               @relation("CallCallee")
  pushSubscriptions PushSubscription[]
  blocksMade        UserBlock[]          @relation("BlocksMade")
  blocksReceived    UserBlock[]          @relation("BlocksReceived")
  reportsMade       UserReport[]         @relation("ReportsMade")
  reportsReceived   UserReport[]         @relation("ReportsReceived")
  posts             Post[]               @relation("PostAuthor")
  postLikes         PostLike[]           @relation("PostLikes")
  postComments      PostComment[]        @relation("CommentAuthor")
  postSaves         PostSave[]           @relation("PostSaves")
  postsSeen         PostSeen[]           @relation("PostsSeen")
  postsHidden       PostHidden[]         @relation("PostsHidden")
  commentLikes      CommentLike[]        @relation("CommentLikes")
  productClicks     PostProductClick[]   @relation("ProductClicks")
  stories           Story[]              @relation("StoryAuthor")
  storyViews        StoryView[]          @relation("StoryViews")
  moduleSwitches    ModuleSwitch[]       @relation("ModuleSwitchEditor")
  supportTickets    SupportTicket[]      @relation("SupportTickets")
  supportAssigned   SupportTicket[]      @relation("SupportAssignee")
  supportMessages   SupportMessage[]     @relation("SupportMessages")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// Foydalanuvchining qo'shimcha ma'lumotlari.
/// Alohida jadval — `users` jadvali yengil qolishi va tez o'qilishi uchun.
model UserProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  /// Ijtimoiy nom: @aziz_karimov.
  ///
  /// ── Nima uchun alohida ustun ────────────────────────────────────────
  /// Profil manzili shu nom bilan ochiladi (`/u/aziz_karimov`).
  /// Ism bilan ochib bo'lmaydi: ismlar takrorlanadi va o'zgaradi,
  /// havola esa barqaror bo'lishi kerak.
  ///
  /// Yagona (`@unique`) — ikki odam bir nomni ola olmaydi.
  username String @unique @db.VarChar(30)

  bio      String? @db.VarChar(300)
  location String? @db.VarChar(80)
  website  String? @db.VarChar(200)

  /// Jins — IXTIYORIY.
  ///
  /// Majburiy emas va profilda ko'rsatilmaydi: u faqat statistika va
  /// kelajakdagi tavsiyalar uchun. So'ralmasa ham ilova to'liq
  /// ishlaydi.
  gender Gender?

  /// Kim xabar yoza oladi.
  ///
  /// Qiymat SHU YERDA saqlanadi, chunki u foydalanuvchining qarori.
  /// Amalda qo'llanishi chat bilan birga keladi — hozircha u faqat
  /// yozib qo'yiladi.
  messagePrivacy MessagePrivacy @default(EVERYONE)

  /// Tasdiqlangan belgisi (ko'k nishon).
  ///
  /// Faqat ADMIN qo'ya oladi — foydalanuvchi o'ziga o'zi bera olmaydi.
  /// Shuning uchun u tahrirlash formasida yo'q.
  isVerified Boolean @default(false)

  dateOfBirth    DateTime?
  language       Language        @default(UZ)
  theme          ThemePreference @default(SYSTEM)
  /// IANA vaqt zonasi, masalan "Asia/Tashkent".
  timezone       String          @default("Asia/Tashkent") @db.VarChar(64)
  /// Marketing xabarnomalariga rozilik.
  marketingOptIn Boolean         @default(false)

  /// Suhbat oynasining foni.
  ///
  /// ── Nima uchun rasm EMAS, NOM saqlanadi ─────────────────────────────
  /// Foydalanuvchi o'z rasmini qo'ysa, u har suhbat ochilganda
  /// yuklanardi va sekin mobil internetda chat kechikib ochilardi.
  ///
  /// Tayyor fonlar esa CSS bilan chiziladi: hajmi nol, har qanday
  /// ekranga moslashadi va qorong'i mavzuda o'zi to'g'rilanadi.
  chatWallpaper String @default("DEFAULT") @db.VarChar(20)

  /// Tanishtiruv (onboarding) qachon tugatilgan.
  ///
  /// ── Nima uchun BAZADA, brauzerda emas ───────────────────────────────
  /// `localStorage` da saqlansa, foydalanuvchi boshqa telefondan yoki
  /// brauzer tarixini tozalagandan keyin tanishtiruvni QAYTA ko'rardi.
  /// Bu esa "ilova meni eslamaydi" degan taassurot qoldiradi.
  ///
  /// `null` — hali ko'rmagan. Sana saqlanadi, `true/false` emas:
  /// keyinchalik "tanishtiruv o'zgardi, eskilarga qayta ko'rsatamiz"
  /// degan qaror uchun sana kerak bo'ladi.
  onboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Rollar ma'lumotnomasi. `RoleName` enum'i bilan bir xil qiymatlarni saqlaydi,
/// lekin tavsif va ruxsatlarni bazada boshqarish imkonini beradi.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String   @db.VarChar(255)
  /// Tizim roli — o'chirib bo'lmaydi.
  isSystem    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

/// Ruxsatlar ma'lumotnomasi. Nomi `modul:resurs:amal` formatida.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(120)
  description String @db.VarChar(255)
  /// Qaysi modulga tegishli (taxi, wallet, commerce...).
  module      String @db.VarChar(50)

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Rol ↔ Ruxsat bog'lovchi jadvali (many-to-many).
model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  assignedAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Foydalanuvchi ↔ Rol bog'lovchi jadvali.
/// Bitta foydalanuvchi bir vaqtda mijoz ham, haydovchi ham bo'lishi mumkin.
model UserRoleAssignment {
  userId String @db.Uuid
  roleId String @db.Uuid

  assignedAt DateTime  @default(now())
  /// Vaqtinchalik rol uchun tugash sanasi (masalan sinov davri).
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

/// Faol sessiya (qurilma). Refresh token'ning faqat hash'i saqlanadi —
/// baza sizib chiqsa ham token'lardan foydalanib bo'lmaydi.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  refreshTokenHash  String    @unique @db.VarChar(255)
  /// Bir oldingi refresh token hash'i — qisqa muhlat uchun.
  ///
  /// Nima uchun kerakligi `session.service.ts` da batafsil yozilgan:
  /// bir vaqtda kelgan ikkinchi yangilash so'rovi eski token bilan
  /// keladi va usiz u O'G'IRLIK deb hisoblanardi.
  previousTokenHash String?   @db.VarChar(255)
  /// Token oxirgi marta qachon almashtirilgan (muhlatni sanash uchun).
  rotatedAt         DateTime?
  userAgent         String?   @db.VarChar(400)
  ipAddress         String?   @db.VarChar(45)
  /// Qurilma nomi ("iPhone 15", "Chrome / Windows").
  deviceLabel       String?   @db.VarChar(120)
  expiresAt         DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime  @default(now())

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Moliya (Wallet)
// ---------------------------------------------------------------------------

/// Foydalanuvchi hamyoni. Balans BigInt tiyinlarda saqlanadi
/// (1 so'm = 100 tiyin) — kasr xatoliklarining oldini olish uchun.
model Wallet {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  /// Joriy balans, tiyinlarda. Manfiy bo'lishi mumkin emas.
  balance  BigInt       @default(0)
  /// Buyurtma uchun band qilingan (hold) summa, tiyinlarda.
  reserved BigInt       @default(0)
  currency String       @default("UZS") @db.VarChar(3)
  status   WalletStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Hamyondagi har bir pul harakati. Bu jadval — o'zgarmas (immutable)
/// buxgalteriya daftari: yozuv o'chirilmaydi, faqat qarama-qarshi yozuv qo'shiladi.
model WalletTransaction {
  id       String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid

  type         TransactionType
  direction    TransactionDirection
  status       TransactionStatus    @default(PENDING)
  /// Summa tiyinlarda. Har doim musbat; yo'nalishni `type` belgilaydi.
  amount       BigInt
  /// Amaldan keyingi balans — tekshiruv (reconciliation) uchun.
  balanceAfter BigInt
  currency     String               @default("UZS") @db.VarChar(3)
  description  String?              @db.VarChar(255)

  /// Tashqi tizim (Payme, Click, Uzum) tranzaksiya raqami.
  externalReference String? @db.VarChar(120)
  /// Takroriy so'rovlarni bloklash uchun kalit (idempotency).
  idempotencyKey    String  @unique @db.VarChar(120)

  /// Qaysi modul yaratgan: "taxi", "food", "payments"...
  sourceModule String  @db.VarChar(50)
  /// Shu moduldagi obyekt ID'si (buyurtma, safar).
  sourceId     String? @db.VarChar(64)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([status])
  @@index([sourceModule, sourceId])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// Umumiy (Shared)
// ---------------------------------------------------------------------------

/// Saqlangan manzillar. Taksi, ovqat va yetkazib berish modullari birgalikda ishlatadi.
model Address {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  type       AddressType @default(OTHER)
  label      String      @db.VarChar(60)
  country    String      @default("UZ") @db.VarChar(2)
  city       String      @db.VarChar(100)
  district   String?     @db.VarChar(100)
  street     String      @db.VarChar(200)
  building   String?     @db.VarChar(50)
  apartment  String?     @db.VarChar(50)
  postalCode String?     @db.VarChar(20)
  /// Geografik koordinatalar — xarita va masofani hisoblash uchun.
  latitude   Decimal     @db.Decimal(10, 7)
  longitude  Decimal     @db.Decimal(10, 7)
  notes      String?     @db.VarChar(255)
  isDefault  Boolean     @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodOrders   FoodOrder[]
  marketOrders MarketOrder[]

  @@index([userId])
  @@index([city])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Ovqat yetkazish (Food delivery)
// ---------------------------------------------------------------------------

/// Restoran.
///
/// Nima uchun narxlar shu yerda emas, `MenuItem` da: bitta restoranda
/// yuzlab taom bo'lishi mumkin va har birining narxi alohida o'zgaradi.
model Restaurant {
  id String @id @default(uuid()) @db.Uuid

  /// Restoran EGASI — u kabinetga kirib buyurtmalarni boshqaradi.
  ///
  /// Ixtiyoriy: seed bilan yaratilgan restoranlarda ega bo'lmasligi
  /// mumkin (ular hali hech kimga biriktirilmagan). Ega o'chirilsa
  /// restoran qolaveradi — shuning uchun `SetNull`.
  ownerId String? @db.Uuid

  /// Manzildagi barqaror nom: "milliy-taomlar".
  slug        String @unique @db.VarChar(60)
  name        String @db.VarChar(120)
  description String @db.VarChar(255)
  /// Oshxona turi: "Milliy", "Fast food", "Yapon".
  cuisine     String @db.VarChar(60)

  /// Qidiruv uchun tayyorlangan nom: "Do'stlik Kafe" → "dostlik kafe".
  ///
  /// `toSearchText()` (src/lib/search.ts) natijasi. Nom o'zgarganda
  /// SHU USTUN HAM yangilanishi shart — invariantni buzmaslik uchun
  /// nom faqat seed orqali yoziladi.
  searchName String @db.VarChar(200)

  /// Yetkazib berish narxi va eng kam buyurtma — TIYINDA.
  deliveryFee     BigInt
  minOrder        BigInt
  /// Taxminiy yetkazish vaqti (daqiqa).
  deliveryMinutes Int

  /// Reyting 0.0 dan 5.0 gacha. `Decimal` — kasr aniq saqlanishi uchun.
  rating      Decimal @default(0) @db.Decimal(2, 1)
  ratingCount Int     @default(0)

  /// Interfeysdagi rang kaliti (`ServiceColor`).
  color String @db.VarChar(20)

  /// Ro'yxatda ko'rinadimi (admin boshqaradi).
  isActive  Boolean @default(true)
  /// Hozir buyurtma qabul qilyaptimi (ish vaqti).
  isOpen    Boolean @default(true)
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  categories MenuCategory[]
  items      MenuItem[]
  orders     FoodOrder[]
  business   BusinessProfile?

  @@index([isActive, sortOrder])
  @@index([ownerId])
  @@index([searchName])
  @@map("restaurants")
}

/// Menyu bo'limi: "Issiq taomlar", "Salatlar", "Ichimliklar".
model MenuCategory {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  name      String @db.VarChar(80)
  sortOrder Int    @default(100)

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  /// Bitta restoranda bir xil nomli ikkita bo'lim bo'lmasin.
  @@unique([restaurantId, name])
  @@map("menu_categories")
}

/// Menyudagi bitta taom.
model MenuItem {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  categoryId   String @db.Uuid

  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)
  /// Narx TIYINDA.
  price       BigInt

  /// Qidiruv uchun tayyorlangan nom: "Lag'mon" → "lagmon".
  /// Izohi `Restaurant.searchName` da.
  searchName String @db.VarChar(200)

  /// Tugab qolgan bo'lsa `false` — menyuda ko'rinadi, lekin tanlab bo'lmaydi.
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems FoodOrderItem[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId, sortOrder])
  /// AI yordamchi menyudan taom qidiradi — indekssiz bu butun jadvalni o'qirdi.
  @@index([searchName])
  @@map("menu_items")
}

/// Ovqat buyurtmasi.
///
/// ── Nima uchun manzil MATN sifatida ham saqlanadi ────────────────────
/// `addressId` bog'lanishi yetarli emas: foydalanuvchi manzilni
/// o'chirishi yoki tahrirlashi mumkin. Shunda eski buyurtma "qayerga
/// yetkazilgan?" degan savolga javob bera olmasdi. Shuning uchun
/// buyurtma paytidagi manzil MATNI nusxa qilib saqlanadi.
model FoodOrder {
  id String @id @default(uuid()) @db.Uuid

  userId       String  @db.Uuid
  restaurantId String  @db.Uuid
  /// Manzil o'chirilsa `null` bo'ladi, lekin matn qoladi.
  addressId    String? @db.Uuid

  /// Foydalanuvchi ko'rsatadigan raqam: NVX-F-20260803-A1B2C3.
  orderNumber String          @unique @db.VarChar(40)
  status      FoodOrderStatus @default(PENDING)

  /// Summalar TIYINDA. `total = subtotal + deliveryFee`.
  subtotal    BigInt
  deliveryFee BigInt
  total       BigInt

  /// Buyurtma paytidagi manzil matni — o'zgarmas nusxa.
  deliveryAddress String  @db.VarChar(400)
  /// Kuryer uchun izoh: "domofon 45", "eshik oldiga qoldiring".
  deliveryNote    String? @db.VarChar(255)

  /// Hamyondagi to'lov tranzaksiyasi.
  walletTransactionId String? @db.Uuid
  /// Bekor qilinganda — sababi va qaytarish tranzaksiyasi.
  cancelReason        String? @db.VarChar(255)
  refundTransactionId String? @db.Uuid

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  address    Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items      FoodOrderItem[]
  /// Kuryer topshirig'i — restoran "yo'lga chiqarish" bosgach yaratiladi.
  delivery   Delivery?

  @@index([userId, createdAt])
  @@index([status])
  @@map("food_orders")
}

/// Buyurtmadagi bitta qator.
///
/// Taom nomi va narxi BU YERGA NUSXA qilinadi. Restoran ertaga narxni
/// oshirsa yoki taomni o'chirsa, eski chek o'zgarmasligi kerak —
/// aks holda foydalanuvchi "men boshqa narx to'lagandim" deya olardi
/// va biz isbotlay olmasdik.
model FoodOrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @db.Uuid
  /// Taom o'chirilsa ham qator qoladi.
  menuItemId String? @db.Uuid

  /// Buyurtma paytidagi nom va narx (TIYINDA).
  name      String @db.VarChar(120)
  unitPrice BigInt
  quantity  Int
  /// `unitPrice * quantity` — hisobni qayta hisoblamaslik uchun saqlanadi.
  lineTotal BigInt

  order    FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("food_order_items")
}

/// Barcha modullardan keladigan bildirishnomalar.
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  channel      NotificationChannel @default(IN_APP)
  status       NotificationStatus  @default(QUEUED)
  title        String              @db.VarChar(150)
  body         String              @db.VarChar(1000)
  /// Bosilganda ochiladigan manzil.
  actionUrl    String?             @db.VarChar(500)
  /// Qaysi modul yubordi.
  sourceModule String              @db.VarChar(50)
  /// Qo'shimcha strukturasiz ma'lumot (buyurtma ID, narx...).
  payload      Json?

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

/// Audit jurnali — kim, qachon, nima qildi.
/// Xavfsizlik tekshiruvi va nizolarni hal qilish uchun majburiy.
/// To'lov qabul qiluvchi xizmat (Hududgaz, Beeline, Uzonline...).
///
/// Nima uchun alohida jadval, kodda ro'yxat emas: provayderlar tez-tez
/// o'zgaradi — yangisi qo'shiladi, eskisi yopiladi, tarif o'zgaradi.
/// Har safar kodni qayta chiqarish o'rniga bazadan boshqariladi.
model ServiceProvider {
  id String @id @default(uuid()) @db.Uuid

  /// Kod — barqaror identifikator ("hududgaz", "beeline").
  code     String          @unique @db.VarChar(50)
  name     String          @db.VarChar(120)
  category ServiceCategory

  /// Qisqa izoh — foydalanuvchi to'g'ri provayderni tanlashi uchun.
  description String? @db.VarChar(255)

  /// Hisob raqami maydonining nomi: "Shaxsiy hisob raqami", "Telefon raqami".
  accountLabel String @db.VarChar(60)
  /// Kiritishga yordam beruvchi namuna: "1234567890".
  accountHint  String @db.VarChar(60)
  /// Hisob raqamini tekshirish uchun naqsh (regex). Server tomonda ishlatiladi.
  accountRegex String @db.VarChar(200)

  /// To'lov chegaralari, TIYINDA.
  minAmount BigInt
  maxAmount BigInt

  /// Interfeysdagi rang kaliti (`ServiceColor`).
  color String @db.VarChar(20)

  isActive  Boolean @default(true)
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedAccounts SavedAccount[]
  payments      ServicePayment[]

  @@index([category, isActive, sortOrder])
  @@map("service_providers")
}

/// Foydalanuvchi saqlab qo'ygan hisob (masalan uyining gaz raqami).
///
/// Nima uchun kerak: kommunal to'lov har oy takrorlanadi. Raqamni har
/// safar qayta kiritish uzoq va xatoga moyil.
model SavedAccount {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  providerId String @db.Uuid

  /// Hisob raqami — provayder talab qilgan ko'rinishda.
  accountNumber String @db.VarChar(60)
  /// Foydalanuvchi bergan nom: "Uy gazi", "Onamning telefoni".
  label         String @db.VarChar(60)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  /// Bir xil provayderga bir xil raqam ikki marta saqlanmasin.
  @@unique([userId, providerId, accountNumber])
  @@index([userId, deletedAt])
  @@map("saved_accounts")
}

/// Bajarilgan xizmat to'lovi.
///
/// Pulning o'zi `WalletTransaction` orqali harakatlanadi; bu jadval
/// esa "kimga, qaysi hisobga, qancha" degan SOHA ma'lumotini saqlaydi.
/// Ikkisi `walletTransactionId` orqali bog'langan.
model ServicePayment {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  providerId String @db.Uuid

  accountNumber String               @db.VarChar(60)
  /// Summa TIYINDA.
  amount        BigInt
  status        ServicePaymentStatus @default(PENDING)

  /// Chek raqami — foydalanuvchi nizo chiqqanda shuni ko'rsatadi.
  receiptNumber String @unique @db.VarChar(40)

  /// Hamyondagi tegishli tranzaksiya.
  walletTransactionId String? @db.Uuid
  /// Provayder tizimidagi raqam (real integratsiyada to'ldiriladi).
  externalReference   String? @db.VarChar(120)
  /// Rad etilgan bo'lsa — sababi.
  failureReason       String? @db.VarChar(255)

  /// Pul qaytarilgan bo'lsa — kim, qachon va nima uchun.
  ///
  /// `failureReason` dan alohida saqlanadi: "provayder rad etdi" va
  /// "admin qaytardi" butunlay boshqa hodisalar, ularni bitta ustunga
  /// aralashtirish tarixni o'qib bo'lmas qiladi.
  refundedAt          DateTime?
  refundReason        String?   @db.VarChar(255)
  /// Qaytarishni bajargan xodim.
  refundedById        String?   @db.Uuid
  /// Qaytarish uchun yaratilgan hamyon tranzaksiyasi.
  refundTransactionId String?   @db.Uuid

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
  @@map("service_payments")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Amalni bajargan foydalanuvchi. Tizim amallarida bo'sh bo'lishi mumkin.
  actorId String? @db.Uuid

  /// Bajarilgan amal, masalan "user.login", "wallet.transfer".
  action       String  @db.VarChar(120)
  /// Ta'sir ko'rsatilgan obyekt turi ("User", "Wallet").
  resourceType String  @db.VarChar(60)
  resourceId   String? @db.VarChar(64)
  module       String  @db.VarChar(50)

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(400)
  /// So'rov ID'si — log fayllari bilan solishtirish uchun.
  requestId String? @db.VarChar(64)
  /// O'zgarish tafsilotlari (oldingi va yangi qiymatlar).
  metadata  Json?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// MARKETPLACE
// ---------------------------------------------------------------------------

/// Savdo maydonchasidagi do'kon.
///
/// `Restaurant` ga o'xshaydi, lekin ikkita muhim farqi bor:
///  - do'konda YETKAZISH MUDDATI kunlarda o'lchanadi, daqiqalarda emas;
///  - do'kon "ochiq/yopiq" emas, "faol/nofaol" bo'ladi — onlayn savdo
///    ish vaqtiga bog'liq emas.
model Shop {
  id String @id @default(uuid()) @db.Uuid

  /// Do'kon EGASI — u kabinetga kirib buyurtmalarni boshqaradi.
  /// Ega o'chirilsa do'kon qolaveradi (`SetNull`).
  ownerId String? @db.Uuid

  /// Manzildagi barqaror nom: "texnomart".
  slug        String @unique @db.VarChar(60)
  name        String @db.VarChar(120)
  description String @db.VarChar(255)

  /// Qidiruv uchun tayyorlangan nom. Izohi `Restaurant.searchName` da.
  searchName String @db.VarChar(200)

  /// Yetkazib berish narxi va eng kam buyurtma — TIYINDA.
  deliveryFee  BigInt
  minOrder     BigInt
  /// Taxminiy yetkazish muddati (KUN).
  deliveryDays Int

  rating      Decimal @default(0) @db.Decimal(2, 1)
  ratingCount Int     @default(0)

  /// Interfeysdagi rang kaliti (`ServiceColor`).
  color String @db.VarChar(20)

  /// Ro'yxatda ko'rinadimi (ADMIN boshqaradi).
  isActive Boolean @default(true)

  /// Hozir buyurtma qabul qilyaptimi (SOTUVCHI boshqaradi).
  ///
  /// `isActive` dan farqi egalikda: do'kon ta'tilga chiqqanda yoki
  /// omborni sanayotganda o'zini vaqtincha yopadi. Yopiq do'kon
  /// ro'yxatda ko'rinadi va mahsulotlari o'qiladi, lekin yangi
  /// buyurtma qabul qilmaydi — restorandagi `isOpen` bilan bir xil.
  isOpen Boolean @default(true)

  sortOrder Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User?            @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  products Product[]
  orders   MarketOrder[]
  business BusinessProfile?

  @@index([isActive, sortOrder])
  @@index([ownerId])
  @@index([searchName])
  @@map("shops")
}

/// Mahsulot toifasi: "Telefonlar", "Kiyim", "Kitoblar".
///
/// ── Nima uchun do'konga BOG'LIQ EMAS ──────────────────────────────────
/// Menyu bo'limi ("Salatlar") faqat o'sha restoranga tegishli. Toifa esa
/// butun maydoncha bo'ylab umumiy: foydalanuvchi "telefon" izlaganda
/// BARCHA do'konlardagi telefonlarni ko'rishi kerak. Shuning uchun toifa
/// alohida jadval va do'kon bilan bog'lanmagan.
model ProductCategory {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(60)
  name String @db.VarChar(80)
  /// Interfeysdagi ikonka kaliti (`lucide-react` nomi).
  icon String @db.VarChar(40)

  sortOrder Int @default(100)

  createdAt DateTime @default(now())

  products Product[]

  @@index([sortOrder])
  @@map("product_categories")
}

/// Sotuvdagi mahsulot.
model Product {
  id         String @id @default(uuid()) @db.Uuid
  shopId     String @db.Uuid
  categoryId String @db.Uuid

  /// Manzildagi barqaror nom: "samsung-galaxy-a55".
  slug        String  @unique @db.VarChar(80)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(1000)

  /// Narx TIYINDA.
  price    BigInt
  /// Chegirmadan oldingi narx — faqat ko'rsatish uchun.
  oldPrice BigInt?

  /// Qidiruv uchun tayyorlangan nom. Izohi `Restaurant.searchName` da.
  ///
  /// Menyudan farqi: mahsulot nomini SOTUVCHI yozadi (sotuvchi kabineti),
  /// shuning uchun bu ustun seed'da emas, `seller.service.ts` da
  /// `toSearchText(name)` orqali to'ldiriladi. Nom o'zgarganda u ham
  /// birga yoziladi — invariant bitta joyda saqlanadi.
  searchName String @db.VarChar(220)

  /// ── ZAXIRA — marketplace'ning eng nozik joyi ────────────────────────
  /// Restoran yana lag'mon pishira oladi, do'konda esa 3 ta telefon bo'lsa
  /// to'rtinchisini sota olmaydi. Buyurtma berilganda bu son SHART BILAN
  /// kamaytiriladi (`stock >= quantity`), aks holda ikki xaridor bir vaqtda
  /// oxirgi mahsulotni sotib olardi.
  stock Int @default(0)

  isActive  Boolean @default(true)
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop       Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems MarketOrderItem[]
  /// Shu mahsulot biriktirilgan videolar.
  postLinks  PostProduct[]
  stories    Story[]           @relation("StoryProduct")

  @@index([shopId, isActive])
  @@index([categoryId, sortOrder])
  @@index([searchName])
  /// Narx bo'yicha saralash va filtrlash uchun.
  @@index([isActive, price])
  @@map("products")
}

/// Marketplace buyurtmasi.
///
/// Manzil MATN sifatida ham saqlanadi — sababi `FoodOrder` da yozilgan.
model MarketOrder {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  shopId    String  @db.Uuid
  addressId String? @db.Uuid

  /// Foydalanuvchi ko'rsatadigan raqam: NVX-M-20260805-A1B2C3.
  orderNumber String            @unique @db.VarChar(40)
  status      MarketOrderStatus @default(PENDING)

  /// Summalar TIYINDA. `total = subtotal + deliveryFee`.
  subtotal    BigInt
  deliveryFee BigInt
  total       BigInt

  deliveryAddress String  @db.VarChar(400)
  deliveryNote    String? @db.VarChar(255)

  walletTransactionId String? @db.Uuid
  cancelReason        String? @db.VarChar(255)
  refundTransactionId String? @db.Uuid

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  address  Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items    MarketOrderItem[]
  /// Kuryer topshirig'i — do'kon "yo'lga chiqarish" bosgach yaratiladi.
  delivery Delivery?

  @@index([userId, createdAt])
  @@index([shopId, status])
  @@index([status])
  @@map("market_orders")
}

/// Buyurtmadagi bitta qator — nom va narx NUSXA qilinadi.
/// Sababi `FoodOrderItem` da yozilgan.
model MarketOrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String? @db.Uuid

  name      String @db.VarChar(160)
  unitPrice BigInt
  quantity  Int
  lineTotal BigInt

  /// Qaysi VIDEO bu xaridni keltirdi.
  ///
  /// ── Nima uchun bu ustun MUHIM ───────────────────────────────────────
  /// Usiz sotuvchi "videom foydali bo'ldimi?" degan savolga javob
  /// ololmasdi. Ko'rish va bosish sonlari qiziqishni ko'rsatadi, lekin
  /// PUL kelganini faqat shu ustun ko'rsatadi.
  ///
  /// ── Nima uchun `SetNull` ────────────────────────────────────────────
  /// Post o'chirilsa buyurtma o'z joyida qolishi SHART: u pul bilan
  /// bog'liq yozuv. Faqat "qayerdan kelgani" yo'qoladi.
  sourcePostId String? @db.Uuid

  order      MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourcePost Post?       @relation("OrderSource", fields: [sourcePostId], references: [id], onDelete: SetNull)

  @@index([orderId])
  /// "Shu videodan nechta buyurtma keldi" so'rovi uchun.
  @@index([sourcePostId])
  @@map("market_order_items")
}

// ---------------------------------------------------------------------------
// Kuryer (Courier)
// ---------------------------------------------------------------------------

enum DeliveryStatus {
  /// Umumiy ro'yxatda turibdi — istalgan kuryer olishi mumkin.
  OFFERED
  /// Kuryer o'ziga oldi, hali olib chiqmagan.
  ACCEPTED
  /// Buyurtma kuryerning qo'lida, yo'lda.
  PICKED_UP
  /// Mijozga topshirildi.
  DELIVERED
  /// Buyurtma bekor qilingani uchun yetkazish ham bekor bo'ldi.
  CANCELLED
}

/// Bitta yetkazish topshirig'i.
///
/// ── Nima uchun ALOHIDA jadval ─────────────────────────────────────────
/// `courierId` ni to'g'ridan-to'g'ri `food_orders` va `market_orders` ga
/// qo'shish mumkin edi. Lekin unda kuryerga tegishli hamma narsa
/// (qachon oldi, qachon olib chiqdi, qancha ishladi) IKKI jadvalda
/// takrorlanardi va har yangi modul — taksi, dorixona — uchinchi
/// nusxani talab qilardi.
///
/// Bu jadval esa "yetkazish" tushunchasini bir joyda saqlaydi: kuryer
/// kabineti bitta manbadan o'qiydi, buyurtma turi esa unga deyarli
/// ahamiyatsiz.
///
/// ── Nima uchun IKKITA ixtiyoriy havola ────────────────────────────────
/// Yetkazish yo ovqat, yo mahsulot buyurtmasiga tegishli — hech qachon
/// ikkalasiga birdan emas va hech qachon hech qaysisiga emas. Buni
/// Prisma sxemasida ifodalab bo'lmaydi, shuning uchun migratsiyada
/// PostgreSQL `CHECK` cheklovi qo'yilgan: aynan BITTASI to'lgan
/// bo'lishi shart. Qoidani baza qo'riqlaydi, dastur emas.
// ---------------------------------------------------------------------------
// Mehmonxona (Hotel)
// ---------------------------------------------------------------------------

/// Mehmonxona.
model Hotel {
  id String @id @default(uuid()) @db.Uuid

  slug        String @unique @db.VarChar(120)
  name        String @db.VarChar(160)
  /// Apostrofsiz nusxa — qidiruv uchun (sabab `src/lib/search.ts` da).
  searchName  String @db.VarChar(160)
  description String @db.VarChar(1000)

  city    String @db.VarChar(80)
  address String @db.VarChar(300)

  /// Yulduzlar soni (1–5).
  stars Int @default(3)

  /// Reyting — 4.7 kabi. Kasr son, chunki bu PUL emas.
  rating      Float @default(0)
  ratingCount Int   @default(0)

  /// Qulayliklar: "Wi-Fi", "Nonushta", "Avtoturargoh".
  ///
  /// Alohida jadval emas: ular faqat KO'RSATISH uchun va ular
  /// bo'yicha filtr qilinmaydi. Jadval qo'shish keraksiz murakkablik
  /// bo'lardi.
  amenities String[] @db.VarChar(60)

  color     String  @db.VarChar(20)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms HotelRoom[]

  @@index([city, isActive])
  @@index([searchName])
  @@map("hotels")
}

/// Mehmonxonadagi xona TURI (nomer emas).
///
/// ── Nima uchun aynan TUR ──────────────────────────────────────────────
/// Har bir xonani alohida yozuv qilish mumkin edi ("204-xona"), lekin
/// mehmon xona RAQAMINI tanlamaydi — u "Standart" yoki "Lyuks" ni
/// tanlaydi.
///
/// Shuning uchun bu yerda tur va uning SONI saqlanadi. Bo'sh joy
/// borligi shu son bilan solishtirib aniqlanadi.
model HotelRoom {
  id      String @id @default(uuid()) @db.Uuid
  hotelId String @db.Uuid

  name        String  @db.VarChar(120)
  description String? @db.VarChar(500)

  /// Nechta mehmon sig'adi.
  capacity Int @default(2)

  /// Bir kecha narxi — TIYINDA.
  pricePerNight BigInt

  /// Shu turdagi xonalar soni — bandlik shu songa qarab hisoblanadi.
  totalRooms Int @default(1)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  hotel    Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings HotelBooking[]

  @@index([hotelId, isActive])
  @@map("hotel_rooms")
}

/// Bandlov.
model HotelBooking {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roomId String @db.Uuid

  /// Foydalanuvchi ko'rsatadigan raqam: NVX-H-20260806-A1B2C3.
  bookingNumber String        @unique @db.VarChar(40)
  status        BookingStatus @default(CONFIRMED)

  /// Kirish va chiqish SANALARI — vaqtsiz.
  ///
  /// ── Nima uchun `@db.Date` ───────────────────────────────────────────
  /// Mehmon "5-avgustda kelaman" deydi, "5-avgust 00:00:00 UTC" demaydi.
  /// Vaqt bilan saqlansa, vaqt zonasi tufayli sana bir kunga surilib
  /// ketishi mumkin edi — Toshkent UTC+5 va yarim tundan keyingi
  /// bandlov "kechagi kun" bo'lib qolardi.
  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date

  /// Nechta kecha — narx shunga ko'paytiriladi.
  ///
  /// Hisoblab olish mumkin edi, lekin saqlanadi: tarif yoki sana
  /// qoidasi ertaga o'zgarsa ham, kelishilgan hisob o'zgarmasligi
  /// kerak.
  nights Int
  guests Int @default(1)

  /// Summalar TIYINDA.
  pricePerNight BigInt
  totalTiyin    BigInt

  /// Kim yashaydi — bandlov boshqa odam uchun bo'lishi mumkin.
  guestName  String @db.VarChar(120)
  guestPhone String @db.VarChar(20)

  walletTransactionId String? @db.Uuid
  cancelReason        String? @db.VarChar(255)

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Bo'sh joy tekshiruvi: xona + sana oralig'i bo'yicha qidiriladi.
  @@index([roomId, checkIn, checkOut])
  @@index([userId, createdAt])
  @@map("hotel_bookings")
}

/// Foydalanuvchi jo'natgan posilka (yuk).
///
/// ── Ovqat/Marketplace buyurtmasidan FARQI ─────────────────────────────
/// U yerlarda sotuvchi bor: restoran ovqat tayyorlaydi, do'kon tovarni
/// yig'adi. Bu yerda sotuvchi YO'Q — foydalanuvchining o'zi jo'natadi
/// va boshqa odam qabul qiladi.
///
/// ── Nima uchun bu yerda HOLAT (status) yo'q ───────────────────────────
/// Posilkaning yo'li aynan yetkazish bosqichlari bilan bir xil:
/// kuryer oldi → olib chiqdi → topshirdi. Alohida holat ustuni
/// qo'shilsa, ikkita manba bitta haqiqatni aytardi va ular bir-biriga
/// zid bo'lib qolishi mumkin edi.
///
/// Shuning uchun holat FAQAT `Delivery` da. Bu yerda esa o'zgarmas
/// ma'lumot: kimdan, kimga, nima va qancha.
model Parcel {
  id String @id @default(uuid()) @db.Uuid

  /// Kim jo'natdi.
  senderId String @db.Uuid

  /// Foydalanuvchi ko'rsatadigan raqam: NVX-P-20260806-A1B2C3.
  parcelNumber String @unique @db.VarChar(40)

  /// Qayerdan olinadi.
  fromRegion  String  @db.VarChar(60)
  fromAddress String  @db.VarChar(300)
  fromNote    String? @db.VarChar(300)

  /// Qayerga eltiladi.
  toRegion  String  @db.VarChar(60)
  toAddress String  @db.VarChar(300)
  toNote    String? @db.VarChar(300)

  /// Qabul qiluvchi — u ilovada bo'lmasligi ham mumkin.
  recipientName  String @db.VarChar(120)
  recipientPhone String @db.VarChar(20)

  /// Ichida nima bor — kuryer ko'radi va mas'uliyatni biladi.
  description String @db.VarChar(300)

  /// Og'irlik GRAMMDA — butun son bo'lishi uchun.
  ///
  /// Kilogrammni kasr sifatida saqlash pulni float qilib saqlash bilan
  /// bir xil xato: 0.1 + 0.2 hech qachon 0.3 bo'lmaydi.
  weightGrams Int

  /// Summalar TIYINDA.
  ///
  /// `priceTiyin` — mijoz to'lagani, `courierFeeTiyin` — kuryerga
  /// tegadigan qismi. Ikkalasi ALOHIDA saqlanadi: tarif ertaga
  /// o'zgarsa ham, kelishilgan summa o'zgarmasligi kerak.
  priceTiyin      BigInt
  courierFeeTiyin BigInt

  /// To'lov tranzaksiyasi (hamyondan yechilgan).
  walletTransactionId String? @db.Uuid

  /// Bekor qilish sababi — mijoz yoki kuryer ko'rsatadi.
  cancelReason String? @db.VarChar(255)

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  sender   User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  delivery Delivery?

  @@index([senderId, createdAt])
  @@map("parcels")
}

model Delivery {
  id String @id @default(uuid()) @db.Uuid

  /// Kim yetkazadi. `null` — hali hech kim olmagan (umumiy ro'yxat).
  ///
  /// Kuryer o'chirilsa topshiriq qolaveradi va qaytadan taklif
  /// qilinadi — shuning uchun `SetNull`.
  courierId String? @db.Uuid

  /// Aynan bitta manbaga tegishli — `@unique` shuni kafolatlaydi.
  ///
  /// Uchtadan aynan bittasi to'ldiriladi. Buni Prisma sxemasida
  /// ifodalab bo'lmaydi, shuning uchun hakam — bazadagi CHECK
  /// cheklovi (`deliveries_exactly_one_source`).
  foodOrderId   String? @unique @db.Uuid
  marketOrderId String? @unique @db.Uuid
  parcelId      String? @unique @db.Uuid

  status DeliveryStatus @default(OFFERED)

  /// Kuryer topadigan haq — TIYINDA.
  ///
  /// Buyurtmadagi `deliveryFee` dan NUSXA olinadi: restoran ertaga
  /// tarifni oshirsa, kelishilgan haq o'zgarmasligi kerak.
  feeTiyin BigInt

  /// Yetkazilgach yozilgan daromad tranzaksiyasi.
  payoutTransactionId String? @db.Uuid

  /// Kuryer bekor qilsa yoki buyurtma bekor bo'lsa — sababi.
  cancelReason String? @db.VarChar(255)

  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  courier     User?        @relation("CourierDeliveries", fields: [courierId], references: [id], onDelete: SetNull)
  foodOrder   FoodOrder?   @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  marketOrder MarketOrder? @relation(fields: [marketOrderId], references: [id], onDelete: Cascade)
  parcel      Parcel?      @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  /// Umumiy ro'yxat: "egasiz va taklif qilingan" — eng tez-tez so'rov.
  @@index([status, createdAt])
  /// Kuryerning o'z topshiriqlari.
  @@index([courierId, status])
  @@map("deliveries")
}

// ---------------------------------------------------------------------------
// Ish qidirish (Jobs)
// ---------------------------------------------------------------------------

/// Bandlik turi.
enum EmploymentType {
  /// To'liq stavka.
  FULL_TIME
  /// Yarim stavka.
  PART_TIME
  /// Shartnoma asosida, muddatli.
  CONTRACT
  /// Amaliyot / stajirovka.
  INTERNSHIP
  /// Masofaviy ish.
  REMOTE
}

/// Talab qilinadigan tajriba.
enum ExperienceLevel {
  /// Tajribasiz ham bo'ladi.
  NONE
  JUNIOR
  MIDDLE
  SENIOR
}

/// Arizaning holati.
///
/// Ovqat va buyurtma holatlaridan FARQI: bu yerda pul yo'q, shuning
/// uchun "bekor qilish" ham pulni qaytarmaydi. Lekin tartib bir xil —
/// faqat oldinga harakat va ikkita yakuniy holat.
enum ApplicationStatus {
  /// Nomzod yubordi, ish beruvchi hali ko'rmagan.
  SENT
  /// Ish beruvchi ochib ko'rdi.
  VIEWED
  /// Suhbatga taklif qilindi.
  INVITED
  /// Rad etildi.
  REJECTED
  /// Nomzod o'zi qaytarib oldi.
  WITHDRAWN
}

/// Ish beruvchi tashkilot.
///
/// Tuzilishi `Shop` bilan bir xil: egasi bor (kabinet keyingi
/// bosqichda), qidiruv uchun tayyorlangan nomi bor va u ro'yxatdan
/// vaqtincha olinishi mumkin.
model Company {
  id String @id @default(uuid()) @db.Uuid

  /// Kompaniya EGASI — u kabinetda vakansiya joylaydi.
  /// Ega o'chirilsa kompaniya qolaveradi.
  ownerId String? @db.Uuid

  slug        String @unique @db.VarChar(60)
  name        String @db.VarChar(120)
  description String @db.VarChar(400)

  /// Qidiruv uchun tayyorlangan nom. Izohi `Restaurant.searchName` da.
  searchName String @db.VarChar(200)

  /// Faoliyat sohasi: "IT", "Savdo", "Qurilish".
  industry String @db.VarChar(60)
  /// Asosiy shahar.
  city     String @db.VarChar(80)

  /// Interfeysdagi rang kaliti (`ServiceColor`).
  color String @db.VarChar(20)

  isActive  Boolean @default(true)
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  vacancies Vacancy[]

  @@index([isActive, sortOrder])
  @@index([ownerId])
  @@index([searchName])
  @@map("companies")
}

/// Kasb yo'nalishi: "IT va dasturlash", "Savdo", "Ta'lim".
///
/// `ProductCategory` bilan bir xil sabab: yo'nalish KOMPANIYAGA emas,
/// butun maydonchaga tegishli. "Dasturchi" izlagan odam BARCHA
/// kompaniyalardagi vakansiyalarni ko'rishi kerak.
model JobCategory {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(60)
  name String @db.VarChar(80)
  /// Interfeysdagi ikonka kaliti (`lucide-react` nomi).
  icon String @db.VarChar(40)

  sortOrder Int @default(100)

  createdAt DateTime @default(now())

  vacancies Vacancy[]

  @@index([sortOrder])
  @@map("job_categories")
}

/// Bo'sh ish o'rni.
model Vacancy {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @db.Uuid
  categoryId String @db.Uuid

  slug        String @unique @db.VarChar(90)
  title       String @db.VarChar(160)
  description String @db.VarChar(4000)

  /// Qidiruv uchun tayyorlangan sarlavha. Izohi `Product.searchName` da.
  searchName String @db.VarChar(220)

  /// ── MAOSH — TIYINDA, ikkalasi ham IXTIYORIY ─────────────────────────
  /// O'zbekistonda e'lonlarning katta qismi "kelishilgan holda" deb
  /// yoziladi. Nolni "bepul ish" deb ko'rsatib bo'lmaydi, shuning uchun
  /// bo'sh qiymat `null` bo'ladi va interfeysda "Kelishilgan" chiqadi.
  ///
  /// Faqat pastki chegara ham bo'lishi mumkin ("2 mln dan").
  salaryMin BigInt?
  salaryMax BigInt?

  employmentType  EmploymentType  @default(FULL_TIME)
  experienceLevel ExperienceLevel @default(NONE)

  city String @db.VarChar(80)

  isActive  Boolean @default(true)
  sortOrder Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     JobCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  applications JobApplication[]

  @@index([companyId, isActive])
  @@index([categoryId, sortOrder])
  @@index([searchName])
  @@index([isActive, createdAt])
  @@map("vacancies")
}

/// Nomzodning arizasi.
///
/// ── Nima uchun BITTA vakansiyaga BITTA ariza ──────────────────────────
/// `@@unique([vacancyId, userId])` — nomzod bir e'longa o'nlab ariza
/// yubora olmaydi. Bu ish beruvchini spamdan himoya qiladi va
/// "qaysi arizasi haqiqiy?" degan savolni butunlay yo'q qiladi.
///
/// Qoidani BAZA qo'riqlaydi: ikki so'rov bir vaqtda kelsa ham
/// ikkinchisi UNIQUE xatosiga uchraydi.
model JobApplication {
  id        String @id @default(uuid()) @db.Uuid
  vacancyId String @db.Uuid
  userId    String @db.Uuid

  status ApplicationStatus @default(SENT)

  /// Nomzodning qisqa xati.
  coverNote String? @db.VarChar(1000)

  /// ── Aloqa raqami NUSXA qilinadi ─────────────────────────────────────
  /// Nomzod keyinchalik profilidagi raqamini o'zgartirishi mumkin.
  /// Ish beruvchi esa ariza kelgan paytdagi raqamga qo'ng'iroq qiladi —
  /// buyurtmadagi manzil bilan bir xil sabab.
  contactPhone String @db.VarChar(20)

  /// Ish beruvchining javobi (taklif matni yoki rad etish sababi).
  employerNote String? @db.VarChar(500)

  createdAt DateTime  @default(now())
  viewedAt  DateTime?
  decidedAt DateTime?

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, userId])
  @@index([userId, createdAt])
  @@index([vacancyId, status])
  @@map("job_applications")
}

// ─────────────────────────────────────────────────────────────────────
// Sayohat (Travel)
// ─────────────────────────────────────────────────────────────────────

/// Takrorlanuvchi reys jadvali.
///
/// ── Nima uchun aniq REYS emas, JADVAL ────────────────────────────────
/// "Toshkent → Samarqand, 08:00" reysi har kuni takrorlanadi. Har kun
/// uchun alohida qator yozilsa, ro'yxat muntazam eskirardi va bir
/// yo'nalish yiliga 365 ta qator olardi.
///
/// Shuning uchun bazada faqat jadval turadi. Aniq reys qidiruv paytida
/// "jadval + sana" dan hisoblanadi va hech qayerda saqlanmaydi —
/// chiptaning o'zi esa shu ikkalasiga bog'lanadi.
model TripSchedule {
  id String @id @default(uuid()) @db.Uuid

  /// Reys raqami: HY-011, 762, A-101.
  code      String        @unique @db.VarChar(20)
  carrier   String        @db.VarChar(120)
  transport TransportType

  fromCity String @db.VarChar(80)
  toCity   String @db.VarChar(80)

  /// Jo'nash vaqti Toshkent bo'yicha, "HH:MM".
  ///
  /// ── Nima uchun satr, `DateTime` emas ───────────────────────────────
  /// Bu KUNLIK vaqt, aniq bir onda sodir bo'ladigan voqea emas.
  /// `DateTime` da saqlansa, sanasi ma'nosiz bo'lgan qandaydir kun
  /// yozilishi kerak bo'lardi va u yolg'on ma'lumot berardi.
  ///
  /// "08:00" ko'rinishi saralashda ham to'g'ri ishlaydi: satrlar
  /// tartibi vaqtlar tartibiga to'g'ri keladi.
  departTime String @db.VarChar(5)

  /// Yo'lda o'tadigan vaqt — DAQIQADA.
  durationMinutes Int

  /// Qatnov kunlari: 1 = dushanba … 7 = yakshanba.
  ///
  /// Alohida jadval emas: ro'yxat qisqa, o'zgarmas va faqat shu
  /// jadvalga tegishli. PostgreSQL massivni o'zi qidira oladi.
  weekdays Int[]

  /// Bir o'rin narxi — TIYINDA.
  priceTiyin BigInt

  /// Reysdagi umumiy o'rinlar soni — bandlik shu songa qarab hisoblanadi.
  totalSeats Int

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings TripBooking[]

  @@index([fromCity, toCity, isActive])
  @@index([transport, isActive])
  @@map("trip_schedules")
}

/// Sotib olingan chipta.
model TripBooking {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  scheduleId String @db.Uuid

  /// Foydalanuvchi ko'rsatadigan raqam: NVX-T-20260810-A1B2C3.
  ticketNumber String        @unique @db.VarChar(40)
  status       BookingStatus @default(CONFIRMED)

  /// Jo'nash SANASI — vaqtsiz.
  ///
  /// Bo'sh o'rinlar shu ustun bo'yicha sanaladi: "shu jadvalda, shu
  /// kuni nechta o'rin sotilgan?".
  departDate DateTime @db.Date

  /// Kelishilgan jo'nash va yetib borish PAYTI.
  ///
  /// ── Nima uchun saqlanadi ───────────────────────────────────────────
  /// Ularni jadvaldan qayta hisoblash mumkin edi. Lekin jadval ertaga
  /// o'zgarishi mumkin (reys vaqti surildi), sotilgan chiptadagi
  /// kelishuv esa o'zgarmasligi kerak. Bundan tashqari pulni qaytarish
  /// qoidasi aynan shu paytga tayanadi.
  departAt DateTime
  arriveAt DateTime

  seats Int @default(1)

  /// Summalar TIYINDA.
  pricePerSeat BigInt
  totalTiyin   BigInt

  /// Bekor qilishda haqiqatda qaytarilgan summa.
  ///
  /// Hisoblab olish mumkin emas: qoida (jarima foizi) keyinchalik
  /// o'zgarishi mumkin, bo'lib o'tgan qaytarish esa o'zgarmaydi.
  refundTiyin BigInt?

  /// Kim ketadi — chipta boshqa odam uchun bo'lishi mumkin.
  passengerName  String @db.VarChar(120)
  passengerPhone String @db.VarChar(20)

  walletTransactionId String? @db.Uuid
  cancelReason        String? @db.VarChar(255)

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule TripSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// Bo'sh o'rin tekshiruvi: jadval + sana + holat bo'yicha qidiriladi.
  @@index([scheduleId, departDate, status])
  @@index([userId, createdAt])
  @@map("trip_bookings")
}

// ─────────────────────────────────────────────────────────────────────
// Navbat (Waitlist) — ilova ochilishidan oldingi ro'yxat
// ─────────────────────────────────────────────────────────────────────

/// Ilova ishga tushishini kutayotgan odam.
///
/// ── Nima uchun `User` emas ────────────────────────────────────────────
/// Bu odam hali ro'yxatdan o'tmagan: parol ham, tasdiqlangan raqam ham
/// yo'q. Uni `users` jadvaliga yozish "kirmagan foydalanuvchi" degan
/// g'alati holat yaratardi va butun autentifikatsiya mantig'i shu
/// holatni har joyda hisobga olishga majbur bo'lardi.
///
/// Ilova ochilganda bu ro'yxat SMS yuborish uchun ishlatiladi, keyin
/// odam odatdagidek ro'yxatdan o'tadi.
model WaitlistEntry {
  id String @id @default(uuid()) @db.Uuid

  /// Telefon raqami E.164 ko'rinishida: +998901234567.
  ///
  /// Yagona (`@unique`): bir odam ikki marta yozilsa, ikkinchisida unga
  /// eski o'rni qaytariladi. Xato ko'rsatish o'rniga — chunki bu
  /// foydalanuvchining aybi emas.
  phone String  @unique @db.VarChar(20)
  name  String? @db.VarChar(120)
  city  String? @db.VarChar(80)

  /// Qayerdan keldi: `instagram`, `telegram`, `tanish`.
  ///
  /// Manzildagi `?from=` dan olinadi. Reklama qayerda ishlaganini
  /// bilish uchun kerak.
  source String? @db.VarChar(60)

  /// Navbatdagi o'rni.
  ///
  /// ── Nima uchun `autoincrement()` ────────────────────────────────────
  /// "Hozirgi sonni sanab, ustiga bitta qo'shish" xavfli: ikki odam bir
  /// vaqtda yozilsa, ikkalasi ham bir xil o'rinni olardi. Ketma-ketlik
  /// (sequence) esa bazaning o'zida, atomik ishlaydi.
  ///
  /// Buning evaziga raqamlarda kamdan-kam bo'shliq paydo bo'lishi
  /// mumkin (masalan 10 dan keyin 12): takroriy yozuv rad etilganda
  /// ketma-ketlik baribir bir qadam oldinga siljiydi. Bu zararsiz —
  /// o'rinlar baribir yagona va o'suvchi bo'lib qolaveradi.
  position Int @unique @default(autoincrement())

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(300)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("waitlist_entries")
}

// ─────────────────────────────────────────────────────────────────────
// Ijtimoiy aloqalar
// ─────────────────────────────────────────────────────────────────────

/// Kuzatuv: kim kimga obuna bo'lgan.
///
/// ── Nima uchun alohida jadval ─────────────────────────────────────────
/// Obunachilar sonini ustunda saqlash mumkin edi, lekin unda "men unga
/// obunamanmi?" degan savolga javob bo'lmasdi va son har qo'shilganda
/// qo'lda yangilanishi kerak bo'lardi — bu esa xatoga eng ochiq joy.
///
/// Bu yerda esa bitta qator = bitta obuna. Son shundan sanaladi.
model Follow {
  id String @id @default(uuid()) @db.Uuid

  /// Kim obuna bo'ldi.
  followerId String @db.Uuid

  /// Kimga obuna bo'ldi.
  followingId String @db.Uuid

  createdAt DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  /// Ikki marta obuna bo'lib bo'lmaydi — baza darajasida.
  @@unique([followerId, followingId])
  /// "Uning obunachilari" va "men kimga obunaman" ro'yxatlari uchun.
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

// ─────────────────────────────────────────────────────────────────────
// Biznes profili (restoran va do'kon uchun umumiy ijtimoiy qatlam)
// ─────────────────────────────────────────────────────────────────────

/// Restoran yoki do'konning OMMAVIY profili.
///
/// ── Nima uchun alohida jadval ─────────────────────────────────────────
/// Manzil, ish vaqti, telefon va obunachilar — restoran uchun ham,
/// do'kon uchun ham bir xil. Ular ikkala jadvalga nusxalansa, ertaga
/// yangi maydon qo'shilganda ikki joyni tahrirlash kerak bo'lardi va
/// bittasi albatta unutilardi.
///
/// ── Nima uchun IKKI ixtiyoriy bog'lanish ──────────────────────────────
/// Profil YO restoranga, YO do'konga tegishli. Ikkalasi ham bo'sh yoki
/// ikkalasi ham to'la bo'lishi mumkin emas — buni baza darajasidagi
/// CHECK sharti ta'minlaydi (migratsiyada). Aynan shu naqsh
/// `deliveries` jadvalida ham ishlatilgan.
model BusinessProfile {
  id String @id @default(uuid()) @db.Uuid

  restaurantId String? @unique @db.Uuid
  shopId       String? @unique @db.Uuid

  city    String  @db.VarChar(80)
  address String  @db.VarChar(300)
  phone   String? @db.VarChar(20)

  /// Ish vaqti Toshkent bo'yicha, "HH:MM".
  ///
  /// Satr sifatida — bu KUNLIK vaqt, aniq bir ondagi voqea emas
  /// (sabab `trip_schedules.departTime` da batafsil yozilgan).
  opensAt  String @db.VarChar(5)
  closesAt String @db.VarChar(5)

  /// Kengaytirilgan tavsif — profil sahifasidagi "Ma'lumot" bo'limi.
  about String? @db.VarChar(600)

  /// Tasdiqlangan biznes (ko'k nishon). Faqat ADMIN qo'yadi.
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant    Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shop          Shop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  followers     BusinessFollow[]
  conversations Conversation[]

  @@map("business_profiles")
}

/// Foydalanuvchining biznesga obunasi.
///
/// `Follow` dan alohida: u odam↔odam bog'lanishi va uning ikkala
/// ustuni ham `users` ga qaraydi. Bittasini biznesga yo'naltirish
/// uchun tashqi kalitni buzish kerak bo'lardi.
model BusinessFollow {
  id String @id @default(uuid()) @db.Uuid

  userId            String @db.Uuid
  businessProfileId String @db.Uuid

  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, businessProfileId])
  @@index([businessProfileId, createdAt])
  @@index([userId, createdAt])
  @@map("business_follows")
}

// ─────────────────────────────────────────────────────────────────────
// Xabarlar (Chat)
// ─────────────────────────────────────────────────────────────────────

/// Suhbat turi.
enum ConversationKind {
  /// Ikki foydalanuvchi o'rtasida.
  DIRECT
  /// Foydalanuvchi va biznes o'rtasida.
  BUSINESS
}

/// Suhbat.
model Conversation {
  id String @id @default(uuid()) @db.Uuid

  kind ConversationKind

  /// Biznes suhbati bo'lsa — qaysi biznes bilan.
  businessProfileId String? @db.Uuid

  /// Suhbatni bir qiymatli aniqlaydigan kalit.
  ///
  /// ── Nima uchun kerak ────────────────────────────────────────────────
  /// "Xabar" tugmasi ikki marta bosilsa, IKKITA suhbat yaratilmasligi
  /// kerak. Ro'yxatda bir odam bilan ikkita chat turishi — eng ko'p
  /// uchraydigan va eng bezovta qiladigan xato.
  ///
  /// Kalit tarkibi:
  ///   DIRECT   — ikki ID tartiblab birlashtiriladi ("a:b"), shuning
  ///              uchun kim birinchi yozganidan qat'i nazar bir xil;
  ///   BUSINESS — "foydalanuvchi:biznes".
  ///
  /// Yagonalik BAZA darajasida: kod xato qilsa ham nusxa paydo
  /// bo'lmaydi.
  pairKey String @unique @db.VarChar(80)

  /// Oxirgi xabar vaqti — ro'yxatni saralash uchun.
  ///
  /// Bu ATAYLAB takror ma'lumot: usiz har bir suhbat uchun oxirgi
  /// xabarni alohida qidirish kerak bo'lardi va ro'yxat sekinlashardi.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())

  business BusinessProfile?     @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
  calls    Call[]

  @@index([lastMessageAt])
  @@map("conversations")
}

/// Suhbat ishtirokchisi.
model ConversationMember {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @db.Uuid
  userId         String @db.Uuid

  /// Shu paytgacha o'qilgan.
  ///
  /// O'qilmagan xabarlar soni shu vaqtdan keyingi xabarlarni sanash
  /// bilan topiladi. Har bir xabar uchun alohida "o'qildi" yozuvi
  /// yuritish ancha aniqroq bo'lardi, lekin jadval xabarlar soniga
  /// ko'paytirilgan holda o'sardi.
  lastReadAt DateTime?

  joinedAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// Xabar.
model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @db.Uuid
  senderId       String @db.Uuid

  /// Xabar matni. Rasm yuborilgan bo'lsa BO'SH bo'lishi mumkin.
  body String @db.VarChar(4000)

  /// Biriktirilgan rasm manzili.
  imageUrl String? @db.VarChar(500)

  /// Ovozli xabar manzili.
  voiceUrl String? @db.VarChar(500)

  /// Ovozli xabar davomiyligi (soniya).
  ///
  /// ── Nima uchun SAQLANADI ────────────────────────────────────────────
  /// Davomiylikni fayldan ham o'qish mumkin edi, lekin buning uchun
  /// brauzer butun faylni yuklab olishi kerak bo'lardi. Ro'yxatda esa
  /// o'nlab ovozli xabar bo'lishi mumkin — ya'ni odam hech birini
  /// tinglamasa ham hammasi yuklanardi.
  voiceSeconds Int?

  /// Xabar tahrirlangan payt.
  ///
  /// ── Nima uchun bu KO'RSATILADI ──────────────────────────────────────
  /// Tahrirlash yashirin bo'lsa, suhbatdosh o'qigan gapi keyin
  /// o'zgartirilishi mumkin bo'lardi — bu nizoga eng ochiq yo'l.
  /// "tahrirlangan" belgisi ishonchni saqlaydi.
  editedAt DateTime?

  /// Qaysi xabarga javob berilgan.
  ///
  /// ── Nima uchun havola, NUSXA emas ───────────────────────────────────
  /// Iqtibos matnini nusxalab qo'yish oson edi, lekin unda asl xabar
  /// tahrirlansa yoki o'chirilsa, iqtibosda eski matn qolib ketardi.
  ///
  /// `onDelete: SetNull` — javob berilgan xabar o'chirilsa, javobning
  /// o'zi YO'QOLMAYDI, faqat havolasi uziladi.
  replyToId String? @db.Uuid

  /// Qabul qiluvchining qurilmasiga yetib borgan payt.
  ///
  /// ── Nima uchun alohida ustun ───────────────────────────────────────
  /// "Yuborildi" va "yetkazildi" boshqa-boshqa holat: birinchisi
  /// server xabarni saqlaganini, ikkinchisi qabul qiluvchi uni
  /// haqiqatda olganini bildiradi. Telefoni o'chiq odamga xabar
  /// yuborilgan, lekin yetkazilmagan bo'ladi.
  deliveredAt DateTime?

  /// O'chirilgan xabar.
  ///
  /// Qator o'chirilmaydi: suhbatning tartibi buzilmasligi va
  /// "bu xabar o'chirilgan" deb ko'rsatish imkoni qolishi kerak.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Xabarga qo'yilgan reaksiya (emoji).
///
/// ── Nima uchun alohida jadval ──────────────────────────────────────────
/// Reaksiyalarni xabar yozuvining o'zida (masalan JSON ustunda) saqlash
/// ham mumkin edi. Lekin unda ikki odam bir vaqtda reaksiya qo'yganda
/// biri ikkinchisining yozuvini o'chirib yuborardi: ikkalasi ham ESKI
/// qiymatni o'qib, o'zinikini qo'shib yozadi.
///
/// Alohida qator esa bunday to'qnashuvni butunlay yo'q qiladi — har kim
/// faqat O'Z qatoriga tegadi.
model MessageReaction {
  id String @id @default(uuid()) @db.Uuid

  messageId String @db.Uuid
  userId    String @db.Uuid

  /// Emoji o'zi — kod sifatida ham, ko'rinish sifatida ham.
  ///
  /// Ruxsat etilgan ro'yxat `config/reactions.ts` da va so'rov
  /// tekshiruvida. Bazada esa faqat uzunlik cheklanadi: yangi emoji
  /// qo'shish uchun har safar ko'chirish yozish kerak bo'lmasin.
  emoji String @db.VarChar(16)

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Bir odam bitta xabarga BITTA reaksiya qo'yadi.
  ///
  /// ── Nima uchun cheklov BAZADA ───────────────────────────────────────
  /// Tugma ikki marta tez bosilsa yoki ikkita qurilmadan bir vaqtda
  /// bosilsa, kod ikkita qator yaratib qo'yishi mumkin. O'shanda bitta
  /// odam sanoqda ikki marta hisoblanardi.
  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

/// Qo'ng'iroq turi.
enum CallKind {
  /// Faqat ovoz.
  AUDIO
  /// Ovoz + video.
  VIDEO
}

/// Qo'ng'iroq holati.
///
/// ── Nima uchun beshta emas, oltita ─────────────────────────────────────
/// "Javob berilmadi" (MISSED) va "rad etildi" (DECLINED) — bir xil emas.
/// Birinchisida odam telefonni ko'rmagan, ikkinchisida ataylab rad etgan.
/// Suhbat tarixida bu ikkalasi boshqacha yoziladi.
enum CallStatus {
  /// Chalinmoqda — hali javob berilmagan.
  RINGING
  /// Suhbat ketmoqda.
  ACTIVE
  /// Qabul qiluvchi rad etdi.
  DECLINED
  /// Javob berilmadi (vaqt tugadi yoki chaqiruvchi bekor qildi).
  MISSED
  /// Suhbat tugadi.
  ENDED
  /// Ulanib bo'lmadi (tarmoq).
  FAILED
}

/// Ovozli/video qo'ng'iroq.
///
/// ── Nima uchun bazada saqlanadi ───────────────────────────────────────
/// Qo'ng'iroqning O'ZI (ovoz) server orqali o'tmaydi — u ikki qurilma
/// o'rtasida to'g'ridan-to'g'ri boradi (WebRTC). Bazada faqat FAKT
/// saqlanadi: kim, kimga, qachon, qancha vaqt.
///
/// Bu kerak: suhbat tarixida "javob berilmagan qo'ng'iroq" ko'rinishi va
/// odam keyin qayta qo'ng'iroq qila olishi uchun. Usiz o'tkazib
/// yuborilgan qo'ng'iroq izsiz yo'qolardi.
model Call {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @db.Uuid

  /// Kim qo'ng'iroq qildi.
  callerId String @db.Uuid
  /// Kimga qo'ng'iroq qilindi.
  calleeId String @db.Uuid

  kind   CallKind
  status CallStatus @default(RINGING)

  /// Chalina boshlagan payt.
  startedAt  DateTime  @default(now())
  /// Javob berilgan payt. Javob berilmasa — bo'sh.
  answeredAt DateTime?
  /// Tugagan payt.
  endedAt    DateTime?

  /// Suhbat davomiyligi (soniyalarda).
  ///
  /// ── Nima uchun alohida ustun ───────────────────────────────────────
  /// Uni `endedAt - answeredAt` bilan hisoblash mumkin edi, lekin
  /// ro'yxatda har qator uchun hisoblash va "umumiy suhbat vaqti"
  /// so'rovlari murakkablashardi. Qiymat BIR MARTA — tugashda yoziladi.
  durationSeconds Int @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User         @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt])
  @@index([calleeId, status])
  @@index([callerId, status])
  @@map("calls")
}

/// Brauzerga "turtki" (push) yuborish uchun obuna.
///
/// ── Nima uchun kerak ──────────────────────────────────────────────────
/// Ilova ochiq bo'lganda xabar jonli ulanish orqali keladi. Lekin ilova
/// YOPIQ bo'lsa hech narsa kelmaydi — odam xabarni ham, qo'ng'iroqni ham
/// o'tkazib yuboradi.
///
/// Push esa brauzerning o'z xizmati orqali boradi: telefon ilovani
/// ochmasdan ham xabarni ko'rsatadi.
///
/// ── Nima uchun qurilma emas, OBUNA ────────────────────────────────────
/// Bitta odamda bir nechta qurilma va brauzer bo'lishi mumkin, har biri
/// alohida obuna beradi. Shuning uchun bu jadval "qurilmalar" emas —
/// aynan obunalar ro'yxati.
model PushSubscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Brauzer bergan manzil — push aynan shu yerga yuboriladi.
  ///
  /// Yagona (`@unique`): bitta brauzer ikki marta obuna bo'lsa,
  /// eskisi yangilanadi, ikkinchi nusxa paydo bo'lmaydi. Aks holda
  /// bitta qurilmaga bir xil xabar ikki marta borardi.
  endpoint String @unique @db.VarChar(500)

  /// Shifrlash kalitlari — ularsiz xabar mazmunini yuborib bo'lmaydi.
  p256dh String @db.VarChar(255)
  auth   String @db.VarChar(255)

  /// Qaysi qurilma ekanini odam taniy olishi uchun.
  deviceLabel String @db.VarChar(100)

  createdAt  DateTime  @default(now())
  /// Oxirgi marta muvaffaqiyatli push yuborilgan payt.
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Shikoyat sababi.
enum ReportReason {
  /// Reklama va keraksiz xabarlar.
  SPAM
  /// Haqorat, tahdid, ta'qib.
  HARASSMENT
  /// Firibgarlik, pul so'rash.
  FRAUD
  /// Boshqa odam yoki tashkilot nomidan ish ko'rish.
  IMPERSONATION
  /// Ro'yxatga tushmagan holat.
  OTHER
}

/// Shikoyat holati.
enum ReportStatus {
  /// Yangi — hali ko'rilmagan.
  OPEN
  /// Ko'rildi va chora ko'rildi.
  REVIEWED
  /// Ko'rildi, asos topilmadi.
  DISMISSED
}

/// Kimga ruxsat berilgan — Feed sozlamalari uchun.
///
/// ── Nima uchun `MessagePrivacy` qayta ishlatilmadi ─────────────────────
/// U nomidan ko'rinib turibdiki XABAR uchun yozilgan va chat moduliga
/// tegishli. Uni izohlar bilan obunaga ham ulasak, ertaga chatga yangi
/// qiymat qo'shilganda (masalan "faqat aloqalarim") u Feed'ga ham
/// tarqalib ketardi.
///
/// Qiymatlar bir xil ko'rinsa ham, ma'nosi boshqa — shuning uchun
/// alohida.
enum AudienceScope {
  /// Hamma.
  EVERYONE
  /// Faqat menga obuna bo'lganlar.
  FOLLOWERS
  /// Hech kim.
  NOBODY
}

/// Feed sozlamalari — har bir odam uchun bitta.
///
/// ── Nima uchun ALOHIDA jadval ─────────────────────────────────────────
/// `UserProfile` allaqachon o'ndan ortiq ustunga ega va u butun ilovaga
/// tegishli (til, mavzu, avatar). Feed sozlamalari esa faqat lentaga
/// tegishli va ular tez-tez o'zgaradi.
///
/// Ular bir jadvalga qo'shilsa, lenta sozlamasi o'zgargan har safar
/// profil qatori ham qayta yozilardi — ya'ni butunlay boshqa modul
/// ma'lumoti bekorga qo'zg'atilardi.
///
/// ── Nima uchun yozuv "kerak bo'lganda" yaratiladi ─────────────────────
/// Yangi ro'yxatdan o'tgan odamning hamma sozlamasi standart. Unga
/// darhol qator yozish — millionlab bo'sh qator degani. Qator faqat
/// odam biror narsani o'zgartirganda paydo bo'ladi.
model FeedSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  /// Qiziqish mavzulari — lentada YUQORIROQ chiqadi.
  ///
  /// Ro'yxat bo'sh bo'lsa, hech narsa ustun emas: yangi odamga
  /// hammasi bir xil ko'rsatiladi.
  interests PostCategory[]

  /// Qizig'i emas — lentaga UMUMAN tushmaydi.
  ///
  /// `interests` bilan kesishmaydi: bir bo'lim bir vaqtda ham
  /// yoqishi, ham yoqmasligi mumkin emas. Buni xizmat ta'minlaydi.
  notInterested PostCategory[]

  /// Shikoyat qilingan, lekin hali ko'rilmagan postlar yashirilsinmi.
  ///
  /// Yoqilgan holda keladi: yangi odam birinchi ochganda noqulay
  /// kontentga duch kelmasligi kerak.
  sensitiveFilter Boolean @default(true)

  /// Profilimni kim ko'ra oladi.
  profileVisibility AudienceScope @default(EVERYONE)
  /// Postlarimga kim izoh yoza oladi.
  commentScope AudienceScope @default(EVERYONE)
  /// Menga kim obuna bo'la oladi.
  followScope AudienceScope @default(EVERYONE)

  /// Bildirishnomalar — har biri alohida o'chiriladi.
  notifyLike    Boolean @default(true)
  notifyComment Boolean @default(true)
  notifyFollow  Boolean @default(true)
  notifyMention Boolean @default(true)
  notifyLive    Boolean @default(true)

  /// Feed bilan tanishtirish qachon tugagan.
  ///
  /// ── Nima uchun BAZADA, brauzerda emas ───────────────────────────────
  /// `localStorage` da saqlash oson bo'lardi, lekin u qurilmaga
  /// bog'langan: odam telefonini almashtirsa yoki brauzer keshini
  /// tozalasa, tanishtiruv yana boshidan chiqardi.
  ///
  /// ── Nima uchun sana, bayroq emas ────────────────────────────────────
  /// Sana "qachon" degan savolga ham javob beradi. Kelajakda Feed
  /// jiddiy o'zgarsa, eski sanali odamlarga yangi tanishtiruv
  /// ko'rsatish mumkin — bayroq bilan buni qilib bo'lmasdi.
  feedOnboardedAt DateTime?

  /// Tavsiyalar oxirgi marta qachon noldan boshlangan.
  ///
  /// ── Nima uchun sana, bayroq emas ────────────────────────────────────
  /// "Tiklandi" degan bayroq bir marta ishlatilib, keyin ma'nosini
  /// yo'qotardi. Sana esa "shu vaqtdan keyingi xatti-harakat
  /// hisobga olinadi" degan aniq chegara beradi.
  recommendationsResetAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feed_settings")
}

/// Bir foydalanuvchi boshqasini bloklagani.
///
/// ── Nima uchun kerak ──────────────────────────────────────────────────
/// Chat va qo'ng'iroq hammaga ochiq. Bloklashsiz bezovta qiluvchi
/// odamdan qutulishning yagona yo'li — ilovani tashlab ketish bo'lardi.
///
/// ── Nima uchun ikki tomonlama ishlaydi ────────────────────────────────
/// Bloklash FAQAT "menga yozmasin" degani emas. Bloklangan odam:
///  · xabar yoza olmaydi va qo'ng'iroq qila olmaydi;
///  · qidiruvda meni topa olmaydi;
///  · profilimni ocha olmaydi;
///  · obuna bo'la olmaydi.
///
/// Aks holda u boshqa yo'l bilan baribir yetib kelardi.
model UserBlock {
  id String @id @default(uuid()) @db.Uuid

  /// Kim bloklagan.
  blockerId String @db.Uuid
  /// Kim bloklangan.
  blockedId String @db.Uuid

  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  /// Bir odamni ikki marta bloklab bo'lmaydi.
  ///
  /// Tugma ikki marta bosilsa yoki ikkita qurilmadan bosilsa, kodda
  /// tekshiruv yetarli bo'lmasdi: o'qish va yozish orasida vaqt bor.
  /// Yagona ishonchli to'siq — bazadagi shart.
  @@unique([blockerId, blockedId])
  /// "Meni kim bloklagan" so'rovi uchun.
  @@index([blockedId])
  @@map("user_blocks")
}

/// Foydalanuvchi ustidan shikoyat.
///
/// ── Nima uchun bloklashdan ALOHIDA ────────────────────────────────────
/// Bloklash — SHAXSIY qaror: u faqat bloklagan odamga ta'sir qiladi.
/// Shikoyat esa moderatorga murojaat: bir necha odam bir kishidan
/// shikoyat qilsa, unga umumiy chora ko'riladi.
///
/// Ikkalasi bir joyda saqlansa, "bloklagan odam avtomatik shikoyat
/// qilgan" bo'lib qolardi — bu esa noto'g'ri statistika beradi.
model UserReport {
  id String @id @default(uuid()) @db.Uuid

  reporterId String @db.Uuid
  /// Shikoyat KIMGA yozilgan.
  ///
  /// Post yoki izoh haqidagi shikoyatda ham to'ldiriladi — u yerda
  /// bu kontent MUALLIFI bo'ladi. Shunda moderator "bu odamga
  /// nechta shikoyat kelgan?" degan savolga bitta so'rov bilan
  /// javob topadi.
  targetId   String @db.Uuid

  /// Shikoyat aynan QAYSI post haqida (bo'lsa).
  ///
  /// ── Nima uchun bu kerak edi ─────────────────────────────────────────
  /// Ilgari faqat ODAM haqida shikoyat qilish mumkin edi. Lentada
  /// haqoratli post ko'rgan odam esa "bu odam yomon" deb umumiy
  /// shikoyat yozardi va moderator uning yuzta postidan qaysi biri
  /// haqida ekanini topa olmasdi.
  postId String? @db.Uuid
  post   Post?   @relation("PostReports", fields: [postId], references: [id], onDelete: Cascade)

  /// Shikoyat aynan QAYSI izoh haqida (bo'lsa).
  commentId String?      @db.Uuid
  comment   PostComment? @relation("CommentReports", fields: [commentId], references: [id], onDelete: Cascade)

  /// Shikoyat aynan QAYSI hikoya haqida (bo'lsa).
  ///
  /// Hikoya 24 soatdan keyin ko'rinmay qoladi, lekin YOZUVI qoladi —
  /// aks holda moderator shikoyat kelgan paytda tekshiradigan narsa
  /// topa olmasdi.
  storyId String? @db.Uuid
  story   Story?  @relation("StoryReports", fields: [storyId], references: [id], onDelete: Cascade)

  reason ReportReason
  /// Qo'shimcha izoh — ixtiyoriy.
  note   String?      @db.VarChar(500)

  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  /// Bir odam bir postga BIR MARTA shikoyat qiladi.
  ///
  /// Usiz norozi odam tugmani o'n marta bosib, moderator ro'yxatini
  /// bitta post bilan to'ldirib qo'yardi va haqiqiy shikoyatlar
  /// ular orasida yo'qolardi.
  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, storyId])
  /// Moderator ro'yxati uchun: yangi shikoyatlar birinchi.
  @@index([status, createdAt])
  @@index([targetId])
  @@map("user_reports")
}

// ─────────────────────────────────────────────────────────────────────
// Lenta (Feed)
// ─────────────────────────────────────────────────────────────────────

/// Foydalanuvchi posti.
///
/// ── Nima uchun sonlar USTUNDA saqlanadi ───────────────────────────────
/// `likeCount` va `commentCount` ni har safar sanash mumkin edi
/// (obunachilar soni aynan shunday sanaladi). Lekin lentada bir ekranda
/// o'nlab post bo'ladi va har biri uchun ikkitadan sanash so'rovi
/// yuborilardi — bu ro'yxatni sekinlashtiradigan eng katta sabab.
///
/// Post obunachidan farqli o'laroq KO'P o'qiladi va KAM o'zgaradi,
/// shuning uchun bu yerda son ustunda turgani to'g'ri. Sonlar
/// tranzaksiya ichida yangilanadi — ya'ni ular hech qachon "adashib"
/// qolmaydi.
/// Postning mavzu bo'limi — Feed tepasidagi kategoriya.
///
/// ── Nima uchun ENUM, erkin matn emas ──────────────────────────────────
/// Kategoriya erkin matn bo'lsa, bir odam "Restoran", ikkinchisi
/// "restoranlar", uchinchisi "ovqat" deb yozardi va filtr ularni
/// boshqa-boshqa bo'lim deb ko'rardi.
///
/// ── Nima uchun "Siz uchun", "Obunalar", "Yaqin atrofda" bu yerda YO'Q ─
/// Ular kategoriya EMAS, lentani ko'rish USULI: birinchisi hammasini,
/// ikkinchisi obunalarni, uchinchisi yaqin atrofdagini ko'rsatadi.
/// Ularni postga yozib bo'lmaydi.
enum PostCategory {
  /// Chegirmalar va aksiyalar.
  DISCOUNTS
  /// Restoran va ovqat.
  RESTAURANTS
  /// Marketplace mahsulotlari.
  MARKETPLACE
  /// Ish va vakansiya.
  JOBS
  /// Yetkazib berish xizmatlari.
  DELIVERY
  /// E'lonlar (ko'chmas mulk, avto va boshqa).
  LISTINGS
  /// Sayohat va mehmonxona.
  TRAVEL
  /// Ta'lim va kurslar.
  EDUCATION
  /// Ijodkorlar kontenti — savdoga bog'liq bo'lmagan.
  CREATORS
}

model Post {
  id String @id @default(uuid()) @db.Uuid

  authorId String @db.Uuid

  /// Qaysi bo'limga tegishli. `null` — muallif tanlamagan.
  ///
  /// ── Nima uchun MAJBURIY emas ────────────────────────────────────────
  /// Oddiy post ("bugun havo yaxshi") hech qaysi bo'limga tushmaydi.
  /// Majburiy qilinsa, odam tasodifiy bo'limni tanlab qo'yardi va
  /// filtr yolg'on natija berardi.
  ///
  /// Tanlanmagan post faqat "Siz uchun" bo'limida ko'rinadi.
  category PostCategory?

  /// Joylashuv nomi — odam ko'radigan yozuv ("Toshkent shahri").
  ///
  /// ── Nima uchun NOM ham, koordinata ham saqlanadi ────────────────────
  /// Koordinata "yaqin atrofda" uchun kerak, nom esa ekranda
  /// ko'rsatish uchun. Nomni koordinatadan har safar hisoblash ham
  /// mumkin edi, lekin unda lentadagi har bir post uchun hisob-kitob
  /// takrorlanardi.
  placeName String? @db.VarChar(120)

  /// Joylashuv koordinatalari — ATAYLAB aniqligi pasaytirilgan.
  ///
  /// ── XAVFSIZLIK: eng muhim qaror ─────────────────────────────────────
  /// Telefon koordinatani bir necha metr aniqlikda beradi. Uni o'z
  /// holicha saqlab, ochiq postga biriktirsak — odam uydan video
  /// joylaganda UY MANZILI hammaga ko'rinardi.
  ///
  /// Shuning uchun yozishdan oldin uch xonali kasrgacha
  /// yaxlitlanadi (~110 metr): "qaysi mahalla" degan savolga javob
  /// beradi, "qaysi uy" degan savolga esa yo'q.
  ///
  /// Yaxlitlash SERVERDA bajariladi — brauzerga ishonib bo'lmaydi.
  latitude  Float?
  longitude Float?

  /// Post matni.
  ///
  /// Uzunlik ataylab cheklangan: uzun maqola uchun bu joy emas va
  /// cheklovsiz matn lentani o'qib bo'lmas holga keltirardi.
  ///
  /// Rasm biriktirilgan bo'lsa BO'SH bo'lishi mumkin.
  body String @db.VarChar(1000)

  /// Biriktirilgan rasm manzili.
  ///
  /// ── Nima uchun faqat BITTA rasm ─────────────────────────────────────
  /// Bir nechta rasm uchun alohida jadval kerak bo'lardi (tartib,
  /// o'chirish, galereya). Bitta rasm esa postlarning aksariyat
  /// qismini qoplaydi va uni keyin kengaytirish mumkin.
  imageUrl String? @db.VarChar(500)

  /// Biriktirilgan VIDEO manzili.
  ///
  /// ── Nima uchun rasmdan alohida ustun ────────────────────────────────
  /// Ikkalasini bitta `mediaUrl` da saqlab, turini kengaytmadan
  /// aniqlash mumkin edi. Lekin unda har bir o'qish joyida "bu rasmmi
  /// yoki videomi?" degan tekshiruv paydo bo'lardi va ular vaqt o'tib
  /// bir-biridan farq qila boshlardi.
  ///
  /// Alohida ustun bilan savol umuman tug'ilmaydi: `videoUrl` bor —
  /// demak bu video post.
  videoUrl String? @db.VarChar(500)

  /// Videoning muqovasi.
  ///
  /// Brauzerda videodan olinadi va rasm sifatida yuklanadi. Usiz
  /// ro'yxatda video yuklanmaguncha qora to'rtburchak turardi —
  /// sekin internetda bu bir necha soniya.
  ///
  /// Muallif muqovani O'ZI tanlaydi (video muharriri): birinchi kadr
  /// ko'pincha qora yoki qiyshiq bo'ladi va u videoning eng yomon
  /// reklamasiga aylanardi.
  videoPosterUrl String? @db.VarChar(500)

  /// Video davomiyligi (soniya) — KESILGANIDAN keyingi uzunlik.
  ///
  /// Ya'ni tomoshabin ko'radigan vaqt, faylning to'liq uzunligi emas.
  /// Ro'yxatdagi yozuv ham, "qisqa/uzun" filtri ham shu sondan
  /// foydalanadi — ikkalasi ham tomoshabinning tajribasi haqida.
  videoSeconds Int?

  /// Kesish nuqtalari — video shu oraliqda o'ynatiladi.
  ///
  /// ── Nima uchun fayl QAYTA KODLANMAYDI ─────────────────────────────
  /// Haqiqiy kesish uchun videoni qayta kodlash kerak. Buni brauzerda
  /// qilishning ikki yo'li bor va ikkalasi ham telefon uchun yaroqsiz:
  /// `ffmpeg.wasm` 30 MB yuklab olishni talab qiladi, `MediaRecorder`
  /// esa real vaqtda ishlaydi (60 soniyalik video — 60 soniya kutish)
  /// va sifatni pasaytiradi.
  ///
  /// Shuning uchun kesish AVVAL belgi sifatida saqlanadi: pleyer
  /// `videoStartSeconds` dan boshlaydi va `videoEndSeconds` da
  /// to'xtaydi. Tomoshabin uchun natija bir xil.
  ///
  /// Cheklovi halol aytiladi: fayl to'liq yuklanadi va to'g'ridan-
  /// to'g'ri havola bilan ochilsa, butun video ko'rinadi. Media
  /// ishlovchisi (server tomonda ffmpeg) qo'shilganda AYNAN shu
  /// maydonlar unga kesish buyrug'i bo'lib xizmat qiladi — ekran
  /// kodiga tegilmaydi.
  ///
  /// `null` — kesilmagan, video butunlay o'ynaydi.
  videoStartSeconds Float?
  videoEndSeconds   Float?

  /// Videoni necha marta ko'rishgan.
  ///
  /// ── Nima uchun USTUNDA saqlanadi ────────────────────────────────────
  /// Har bir ko'rishni alohida qatorga yozib, keyin sanash mumkin
  /// edi — lekin mashhur videoda bu millionlab qator degani va
  /// lentaning har ochilishida ular sanalardi.
  ///
  /// Ustun esa bitta son: o'qish tekin, yozish bitta `increment`.
  /// Buning evaziga "kim ko'rdi" degan savolga javob yo'q, lekin
  /// u hech kimga kerak emas — sotuvchiga SON kerak.
  viewCount Int @default(0)

  likeCount    Int @default(0)
  commentCount Int @default(0)

  /// Post necha marta ulashilgan.
  ///
  /// ── Nima uchun bu son MUHIM ─────────────────────────────────────────
  /// Yoqtirish — "menga yoqdi". Ulashish — "buni boshqalar ham
  /// ko'rsin". Ikkinchisi ancha kuchli belgi va aynan u yangi
  /// odamlarni ilovaga olib keladi.
  shareCount Int @default(0)

  /// Post tahrirlangan payt.
  ///
  /// ── Nima uchun `updatedAt` YETARLI EMAS ─────────────────────────────
  /// `updatedAt` yoqtirish sonini yangilaganda ham o'zgaradi. Ya'ni
  /// kimdir postni yoqtirsa, u "tahrirlangan" bo'lib ko'rinardi.
  ///
  /// Bu ustun esa FAQAT matn o'zgarganda to'ldiriladi va lentada
  /// "tahrirlangan" belgisi shundan chiqadi.
  editedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// O'chirilgan post — yozuv saqlanadi, matni ko'rsatilmaydi.
  ///
  /// Butunlay o'chirilsa, unga yozilgan izohlar ham yo'qolardi va
  /// shikoyat kelganda tekshiradigan narsa qolmasdi.
  deletedAt DateTime?

  author       User               @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes        PostLike[]
  comments     PostComment[]
  reports      UserReport[]       @relation("PostReports")
  seenBy       PostSeen[]
  hiddenBy     PostHidden[]
  products     PostProduct[]
  saves        PostSave[]
  hashtags     PostHashtag[]
  clicks       PostProductClick[]
  orderedItems MarketOrderItem[]  @relation("OrderSource")

  /// Lenta aynan shu tartibda o'qiladi: yangi postlar birinchi.
  @@index([createdAt])
  /// Video lentasi FAQAT videoli postlarni oladi — indekssiz u butun
  /// jadvalni o'qib, keyin ortiqchasini tashlab yuborardi.
  @@index([videoUrl, createdAt])
  /// Profildagi "uning postlari" ro'yxati uchun.
  @@index([authorId, createdAt])
  /// Kategoriya bo'yicha filtr — indekssiz butun jadval o'qilardi.
  @@index([category, createdAt])
  /// "Yaqin atrofda": koordinata oralig'i bo'yicha qidiruv.
  @@index([latitude, longitude])
  @@map("posts")
}

/// Videoga biriktirilgan mahsulot.
///
/// ── Nima uchun ALOHIDA jadval ─────────────────────────────────────────
/// Avval post jadvalida bitta `productId` ustuni bor edi. Lekin bitta
/// videoda ko'pincha bir NECHTA narsa ko'rsatiladi: kiyim + poyabzal +
/// sumka. Bitta ustun bilan odam ulardan faqat bittasini biriktira
/// olardi va qolganini izohda yozardi — ya'ni muammo yechilmagan
/// bo'lardi.
model PostProduct {
  postId    String @db.Uuid
  productId String @db.Uuid

  /// Ro'yxatdagi tartib — odam o'zi qo'ygan tartib saqlanadi.
  sortOrder Int @default(0)

  /// Tugma necha marta bosilgan.
  ///
  /// ── Nima uchun bu son KO'RISHDAN muhimroq ───────────────────────────
  /// Ko'rish — video ekranda o'ynadi. Bosish — odam mahsulotni ochdi,
  /// ya'ni sotib olishga bir qadam qoldi.
  ///
  /// Sotuvchi shu ikki sonni taqqoslab, videosi sotuvga ishlayaptimi
  /// yoki shunchaki tomosha bo'lyaptimi — bilib oladi.
  clickCount Int @default(0)

  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Bitta mahsulot bitta videoga bir marta biriktiriladi.
  @@id([postId, productId])
  @@index([productId])
  @@map("post_products")
}

/// Hikoya — 24 soatdan keyin yo'qoladigan post.
///
/// ── Nima uchun POSTDAN alohida jadval ─────────────────────────────────
/// Postga `expiresAt` ustuni qo'shib, uni "hikoya" deb belgilash ham
/// mumkin edi. Lekin unda LENTANING har bir so'rovi "bu post hikoya
/// emasmi?" degan shartni ko'tarib yurardi va bittasi albatta
/// unutilib, hikoya oddiy lentada paydo bo'lardi.
///
/// Bundan tashqari hikoyada post'da bo'lmagan narsalar bor: kim
/// ko'rgani ro'yxati, muddat, ketma-ket tomosha. Postda esa hikoyada
/// bo'lmagan narsalar: yoqtirish, izoh, ulashish, saqlash.
///
/// ── Nima uchun `expiresAt` HISOBLANMAYDI ──────────────────────────────
/// "createdAt + 24 soat" deb hisoblash mumkin edi. Lekin ertaga muddat
/// o'zgarsa (masalan 48 soat), ESKI hikoyalar ham uzayib ketardi —
/// ya'ni odam joylagan paytdagi shartdan boshqa shart qo'llanardi.
model Story {
  id String @id @default(uuid()) @db.Uuid

  authorId String @db.Uuid

  /// Qisqa izoh — ixtiyoriy. Hikoya asosan RASM yoki VIDEO.
  caption String? @db.VarChar(200)

  /// Rasm yoki video — bittasi ALBATTA to'ldiriladi.
  imageUrl       String? @db.VarChar(500)
  videoUrl       String? @db.VarChar(500)
  videoPosterUrl String? @db.VarChar(500)
  videoSeconds   Int?

  /// Biriktirilgan mahsulot — hikoyada BITTA.
  ///
  /// Hikoya bir necha soniya ko'rinadi: ro'yxat qo'yish uchun vaqt
  /// ham, joy ham yo'q. Bitta tugma esa aynan shu qisqa vaqtga mos.
  productId String? @db.Uuid

  /// Necha marta ochilgan (bir odam bir marta sanaladi).
  viewCount Int @default(0)

  createdAt DateTime  @default(now())
  /// Qachon ko'rinmay qoladi.
  expiresAt DateTime
  /// Muallif o'zi o'chirgan payt.
  deletedAt DateTime?

  author  User         @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  product Product?     @relation("StoryProduct", fields: [productId], references: [id], onDelete: SetNull)
  views   StoryView[]
  reports UserReport[] @relation("StoryReports")

  /// Lentaning tepasidagi halqa uchun: "muddati o'tmagan hikoyalar".
  @@index([expiresAt])
  /// Bitta odamning hikoyalari — joylash tartibida.
  @@index([authorId, createdAt])
  @@map("stories")
}

/// Hikoyani KIM ko'rgani.
///
/// ── Nima uchun ismlar saqlanadi ───────────────────────────────────────
/// Hikoyaning eng kuchli tomoni shu: muallif kim ko'rganini biladi.
/// Sotuvchi uchun bu — "mahsulotimni kim kuzatyapti" degan javob.
///
/// Ko'ruvchi ham buni BILADI: hikoya ochilganda "ko'rganingiz muallifga
/// ko'rinadi" degan yozuv turadi. Yashirin kuzatuv bo'lmasligi kerak.
model StoryView {
  id String @id @default(uuid()) @db.Uuid

  storyId  String @db.Uuid
  viewerId String @db.Uuid

  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation("StoryViews", fields: [viewerId], references: [id], onDelete: Cascade)

  /// Bir odam bir hikoyani BIR MARTA ko'rgan hisoblanadi.
  @@unique([storyId, viewerId])
  @@index([viewerId])
  @@map("story_views")
}

/// Videodagi mahsulot tugmasi bosilgani — KIM va QACHON.
///
/// ── Nima uchun `clickCount` YETARLI EMAS ──────────────────────────────
/// Ustundagi son "nechta bosildi" degan savolga javob beradi. Lekin
/// "shu odam keyin sotib oldimi?" degan savolga javob berish uchun
/// KIM bosgani kerak.
///
/// ── Nima uchun har bosish ALOHIDA qator EMAS ──────────────────────────
/// Mashhur videoda bu millionlab qator degani. Bizga esa faqat ENG
/// OXIRGI bosish kerak: odam ikkita videodan bir mahsulotni ochgan
/// bo'lsa, xaridni oxirgisi keltirgan deb hisoblanadi (reklamada bu
/// "oxirgi bosish" qoidasi deb ataladi).
///
/// Shuning uchun bitta odam + bitta mahsulot uchun BITTA qator turadi
/// va u har bosishda yangilanadi.
model PostProductClick {
  id String @id @default(uuid()) @db.Uuid

  postId    String @db.Uuid
  productId String @db.Uuid
  userId    String @db.Uuid

  /// Oxirgi bosish vaqti — xaridga bog'lash oynasi shundan hisoblanadi.
  clickedAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("ProductClicks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  /// Xarid paytida "shu odam shu mahsulotni bosganmi?" so'rovi uchun.
  @@index([userId, productId, clickedAt])
  @@index([postId])
  @@map("post_product_clicks")
}

/// Postga qo'yilgan yoqtirish.
/// Kim qaysi postni KO'RGAN.
///
/// ── Nima uchun kerak ──────────────────────────────────────────────────
/// Tavsiya tizimidagi eng kuchli qoida — "ko'rganimni qayta ko'rsatma".
/// Usiz lenta har ochilganda bir xil beshta videoni qaytarardi va odam
/// "bu yerda yangi narsa yo'q" degan xulosaga kelardi.
///
/// ── Nima uchun `viewCount` yetarli emas ───────────────────────────────
/// U faqat UMUMIY sonni biladi: "ming marta ko'rilgan". Kim ko'rgani
/// esa noma'lum, ya'ni aynan shu odamga yangi post tanlab bo'lmasdi.
///
/// ── Qo'shimcha foyda: son endi HALOL ──────────────────────────────────
/// Ilgari bitta odam videoni qayta-qayta ochib, ko'rishlar sonini
/// ko'tarib qo'yishi mumkin edi. Endi son bir odamdan BIR MARTA
/// oshadi — ya'ni u "necha kishi ko'rdi" degan ma'noga ega bo'ldi.
model PostSeen {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid
  userId String @db.Uuid

  seenAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostsSeen", fields: [userId], references: [id], onDelete: Cascade)

  /// Bitta odam bitta postni bir marta "ko'rgan" hisoblanadi.
  @@unique([userId, postId])
  /// "Oxirgi ko'rganlarim" — tavsiya uchun signal yig'ishda.
  @@index([userId, seenAt])
  @@map("post_seen")
}

/// "Bu qiziq emas" — odam postni O'ZI yashirgan.
///
/// ── Nima uchun ALOHIDA jadval, sozlamadagi ro'yxat emas ───────────────
/// `FeedSettings.notInterested` butun BO'LIMNI o'chiradi ("menga
/// ish e'lonlari kerak emas"). Bu esa boshqa narsa: bo'lim qiziq,
/// lekin AYNAN shu post qiziq emas.
///
/// Ikkalasini bitta joyga tiqishtirsak, bitta postni yashirgan odam
/// butun bo'limni yo'qotib qo'yardi.
///
/// ── Nima uchun yozuv SAQLANADI, post o'chirilmaydi ────────────────────
/// Post boshqalarniki va u boshqalarga ko'rinishda davom etadi. Bu
/// jadval faqat "kim nimani ko'rmoqchi emas" degan shaxsiy ro'yxat.
model PostHidden {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid
  userId String @db.Uuid

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostsHidden", fields: [userId], references: [id], onDelete: Cascade)

  /// Bitta odam bitta postni ikki marta yashira olmaydi.
  @@unique([userId, postId])
  /// Tavsiyaga manfiy signal yig'ishda — so'nggi yashirishlar bo'yicha.
  @@index([userId, createdAt])
  @@map("post_hidden")
}

model PostLike {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid
  userId String @db.Uuid

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  /// Bitta odam bitta postni ikki marta yoqtira olmaydi.
  ///
  /// Tugma tez-tez bosilishi mumkin, kod esa o'qish va yozish orasida
  /// ulgurmasligi mumkin. Yagona ishonchli to'siq — bazadagi shart.
  @@unique([postId, userId])
  /// "Men yoqtirgan postlar" va lentadagi holat uchun.
  @@index([userId])
  @@map("post_likes")
}

/// Postga yozilgan izoh.
model PostComment {
  id String @id @default(uuid()) @db.Uuid

  postId   String @db.Uuid
  authorId String @db.Uuid

  body String @db.VarChar(500)

  /// Qaysi izohga javob. `null` — bu asosiy izoh.
  ///
  /// ── Nima uchun FAQAT BIR daraja ─────────────────────────────────────
  /// Javobga javob, unga yana javob... deb cheksiz chuqurlashsa,
  /// telefon ekranida matn o'ng chetga siqilib, o'qib bo'lmas holga
  /// keladi.
  ///
  /// Shuning uchun javobning javobi ham AYNAN SHU asosiy izohga
  /// biriktiriladi — YouTube ham xuddi shunday qiladi.
  parentId String? @db.Uuid

  /// Izohga qo'yilgan yoqtirishlar soni.
  likeCount Int @default(0)

  /// Javoblar soni — ro'yxatni ochmasdan turib ko'rinadi.
  replyCount Int @default(0)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reports UserReport[]  @relation("CommentReports")
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")
  likes   CommentLike[]

  /// Izohlar eskisidan yangisiga qarab o'qiladi — suhbat kabi.
  @@index([postId, createdAt])
  /// Bitta izohning javoblari.
  @@index([parentId, createdAt])
  @@map("post_comments")
}

/// Izohga qo'yilgan yoqtirish.
model CommentLike {
  id String @id @default(uuid()) @db.Uuid

  commentId String @db.Uuid
  userId    String @db.Uuid

  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("CommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  /// Bir odam bir izohni ikki marta yoqtira olmaydi.
  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

/// Saqlangan post — "keyin ko'raman" ro'yxati.
///
/// ── Nima uchun yoqtirishdan ALOHIDA ───────────────────────────────────
/// Yoqtirish — OMMAVIY: muallif ko'radi, soni hammaga ko'rinadi.
/// Saqlash — SHAXSIY: uni faqat saqlagan odam ko'radi.
///
/// Ikkalasini birlashtirsak, odam mahsulotni keyin sotib olish uchun
/// belgilaganida buni butun dunyoga e'lon qilgan bo'lardi.
model PostSave {
  id String @id @default(uuid()) @db.Uuid

  postId String @db.Uuid
  userId String @db.Uuid

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostSaves", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  /// "Saqlanganlarim" ro'yxati — oxirgi saqlangani birinchi.
  @@index([userId, createdAt])
  @@map("post_saves")
}

/// Xeshteg — `#poyabzal` kabi mavzu belgisi.
///
/// ── Nima uchun ALOHIDA jadval ─────────────────────────────────────────
/// Xeshteglarni post matnidan har safar qidirish mumkin edi, lekin
/// `LIKE '%#poyabzal%'` butun jadvalni o'qiydi va ming postda ham
/// sekinlashadi.
///
/// Alohida jadval bilan "shu mavzudagi postlar" so'rovi indeks
/// bo'yicha bajariladi.
model Hashtag {
  id String @id @default(uuid()) @db.Uuid

  /// Belgi — KICHIK harflarda, `#` siz saqlanadi.
  ///
  /// `#Poyabzal` va `#poyabzal` bir xil mavzu: ularni ajratsak,
  /// bitta mavzu o'nlab bo'lakka bo'linib ketardi.
  tag String @unique @db.VarChar(50)

  /// Nechta postda ishlatilgan — mashhur mavzular ro'yxati uchun.
  postCount Int @default(0)

  createdAt DateTime @default(now())

  posts PostHashtag[]

  /// "Mashhur mavzular" ro'yxati.
  @@index([postCount])
  @@map("hashtags")
}

/// Post va xeshteg orasidagi bog'lanish.
model PostHashtag {
  postId    String @db.Uuid
  hashtagId String @db.Uuid

  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  /// "Shu mavzudagi postlar" — yangisidan eskisiga.
  @@index([hashtagId, createdAt])
  @@map("post_hashtags")
}

// ─────────────────────────────────────────────────────────────────────
// Xatolar jurnali
// ─────────────────────────────────────────────────────────────────────

/// Xato qayerda yuz berdi.
enum ErrorSource {
  /// Serverdagi API yoki sahifa.
  SERVER
  /// Foydalanuvchining brauzeri.
  BROWSER
}

/// Ilovadagi xato.
///
/// ── Nima uchun tashqi xizmat EMAS ─────────────────────────────────────
/// Sentry kabi xizmatlar kuchli, lekin ular O'zbekistondan har doim
/// ham ochilmaydi (VPN'siz to'siladi, VPN bilan esa ularning o'zi
/// to'sadi). Kuzatuv ochilmaydigan joyda turgani — kuzatuv yo'qligi
/// bilan bir xil.
///
/// Shuning uchun xatolar O'Z bazamizda saqlanadi va admin panelda
/// ko'rinadi. Hech qanday tashqi xizmat, ro'yxatdan o'tish yoki VPN
/// kerak emas.
///
/// ── Nima uchun har xato ALOHIDA qator emas ────────────────────────────
/// Bitta buzilgan sahifa bir kechada minglab bir xil xato yozardi va
/// jadval o'qib bo'lmas holga kelardi. Shuning uchun bir xil xatolar
/// BIR qatorga yig'iladi va `count` oshiriladi.
model ErrorLog {
  id String @id @default(uuid()) @db.Uuid

  /// Bir xil xatolarni birlashtiruvchi barmoq izi.
  ///
  /// Turi, matni va manzilidan hisoblanadi. Yagona — shu sababli
  /// bir xil xato ikkinchi marta qator yaratmaydi.
  fingerprint String @unique @db.VarChar(64)

  source ErrorSource

  /// Xato turi: "TypeError", "PrismaClientKnownRequestError".
  kind String @db.VarChar(120)

  /// Xato matni (qisqartirilgan).
  message String @db.VarChar(1000)

  /// Qaysi manzilda yuz berdi. So'rov parametrlari OLIB TASHLANADI:
  /// ularda token yoki telefon raqami bo'lishi mumkin.
  path String @db.VarChar(300)

  /// HTTP usuli — faqat server xatolarida.
  method String? @db.VarChar(10)

  /// Xato izi (stack). Uzunligi cheklangan: to'liq iz bir necha
  /// kilobayt bo'lishi mumkin va uning oxiri odatda foydasiz.
  stack String? @db.VarChar(4000)

  /// Necha marta takrorlangan.
  count Int @default(1)

  /// Ko'rib chiqilganmi. Yopilgan xato ro'yxatda birinchi turmaydi.
  isResolved Boolean @default(false)

  /// Qaysi versiyada (git commit) yuz berdi.
  version String? @db.VarChar(40)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Yangi xatolar birinchi; yopilganlari pastda.
  @@index([isResolved, lastSeenAt])
  @@index([lastSeenAt])
  @@map("error_logs")
}

/// Bo'limni vaqtincha o'chirib qo'yish (kill-switch).
///
/// ── Nima uchun BAZADA, kodda emas ─────────────────────────────────────
/// Bo'limlar ro'yxati (`src/config/modules.ts`) — kod. Uni o'zgartirish
/// uchun dastur qayta yig'ilishi va tarqatilishi kerak: bu bir necha
/// daqiqa. To'lov tizimi ishdan chiqqanda yoki restoran API si javob
/// bermay qolganda esa bo'limni DARHOL yopish kerak.
///
/// ── Nima uchun faqat O'CHIRILGANLARI yoziladi ─────────────────────────
/// Yozuv YO'Q bo'lsa — bo'lim ochiq. Ya'ni odatiy holat bazaga umuman
/// tegmaydi va yangi bo'lim qo'shilganda uni bu yerga qo'shish esdan
/// chiqmaydi: u shundoq ham ochiq bo'ladi.
model ModuleSwitch {
  /// `AppModule.id` — "food", "marketplace" va hokazo.
  moduleId String @id @db.VarChar(40)

  isEnabled Boolean @default(true)

  /// Nima uchun yopilgani — bu matn FOYDALANUVCHIGA ko'rsatiladi,
  /// shuning uchun ichki qisqartma emas, odam tilida yozilishi kerak.
  reason String? @db.VarChar(200)

  /// Kim o'zgartirgani. Xodim o'chirilsa yozuv qolaveradi (`SetNull`).
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("ModuleSwitchEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@map("module_switches")
}

// ─────────────────────────────────────────────────────────────────────
// Yordam xizmati
// ─────────────────────────────────────────────────────────────────────

/// Murojaatning holati.
enum SupportTicketStatus {
  /// Yangi kelgan, hali hech kim ko'rmagan.
  OPEN
  /// Xodim javob yozdi, foydalanuvchidan javob kutilmoqda.
  ANSWERED
  /// Masala hal qilindi.
  RESOLVED
  /// Yopildi — javob berilmasdan (spam, takroriy murojaat).
  CLOSED
}

/// Murojaat mavzusi — qaysi bo'lim haqida.
enum SupportTicketCategory {
  ORDER
  PAYMENT
  ACCOUNT
  BUG
  OTHER
}

/// Foydalanuvchining yordam so'rovi.
///
/// ── Nima uchun CHATDAN alohida ────────────────────────────────────────
/// Ilovada yozishmalar tizimi bor va murojaatni ham o'sha yerda qilish
/// mumkin edi. Lekin murojaatning chatda yo'q uchta xossasi bor:
///
///  · HOLATI — u ochiladi, javob oladi va yopiladi;
///  · MAVZUSI — qaysi bo'lim haqida ekani ma'lum;
///  · EGASI — uni bitta odam emas, XODIMLAR JAMOASI ko'radi.
///
/// Bulardan tashqari chatda bloklash qoidalari bor: foydalanuvchi
/// xodimni bloklab qo'ysa, o'z murojaatiga javob ololmay qolardi.
model SupportTicket {
  id String @id @default(uuid()) @db.Uuid

  /// Murojaat egasi. Hisob o'chirilsa murojaat ham o'chadi.
  userId String @db.Uuid
  user   User   @relation("SupportTickets", fields: [userId], references: [id], onDelete: Cascade)

  /// Odam o'qiydigan raqam: "NVX-S-20260813-A1B2C3".
  ///
  /// Telefonda gaplashganda ID emas, aynan shu raqam aytiladi —
  /// UUID ni ovoz bilan o'qib bo'lmaydi.
  ///
  /// Uzunlik boshqa raqamlar bilan BIR XIL (40). Avval 20 edi va
  /// raqam bir belgiga sig'may qolgan: murojaat ochish 500 xatosi
  /// bilan tugardi. Yagona o'lchov shunday xatoni takrorlanmas
  /// qiladi.
  ticketNumber String @unique @db.VarChar(40)

  subject  String                @db.VarChar(120)
  category SupportTicketCategory
  status   SupportTicketStatus   @default(OPEN)

  /// Murojaatni o'z zimmasiga olgan xodim.
  ///
  /// Xodim ishdan ketsa murojaat qolaveradi (`SetNull`) — tarix
  /// yo'qolmasligi kerak.
  assigneeId String? @db.Uuid
  assignee   User?   @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Oxirgi xabar vaqti — ro'yxat shu bo'yicha saralanadi.
  ///
  /// Alohida ustun: har safar xabarlar jadvalidan eng yangisini
  /// qidirish uzun ro'yxatda sekin ishlardi.
  lastMessageAt DateTime @default(now())

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Yopilgan payt — javob berish muddatini o'lchash uchun.
  resolvedAt DateTime?

  messages SupportMessage[]

  /// Xodim ochiq murojaatlarni birinchi ko'radi.
  @@index([status, lastMessageAt])
  /// Foydalanuvchi o'z murojaatlarini ko'radi.
  @@index([userId, lastMessageAt])
  @@map("support_tickets")
}

/// Murojaat ichidagi bitta xabar.
model SupportMessage {
  id       String        @id @default(uuid()) @db.Uuid
  ticketId String        @db.Uuid
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Kim yozgan. Xodim hisobi o'chirilsa xabar qolaveradi.
  authorId String? @db.Uuid
  author   User?   @relation("SupportMessages", fields: [authorId], references: [id], onDelete: SetNull)

  /// Xodim yozganmi.
  ///
  /// ── Nima uchun ALOHIDA ustun ────────────────────────────────────────
  /// Buni `authorId != ticket.userId` orqali hisoblash mumkin edi.
  /// Lekin xodim hisobi o'chirilsa `authorId` bo'sh qoladi va eski
  /// xabarlar birdan "foydalanuvchi yozgan" bo'lib ko'rinardi —
  /// yozishmaning ma'nosi teskari o'girilardi.
  isStaff Boolean

  body String @db.VarChar(2000)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
